<div>
  {{!--Power Type --}}
  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.PowerTypes'}}
  {{#*inline "item-field-inputs"}}
  <select name="system.type">
    {{selectOptions config.powerTypes selected=system.type}}
  </select>
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{!-- Times Selected --}}
  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.SelectionLimit'}}
  {{#*inline "item-field-inputs"}}
  {{numberInput system.selectionLimit name="system.selectionLimit" min=0 step=1}}
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{!-- Power has an Activation --}}
  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.PowerActive'}}
  {{#*inline "item-field-inputs"}}
  <input type="checkbox" name="system.canActivate" {{checked system.canActivate}} />
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{#if system.canActivate}}
    {{!-- Power Cost --}}
    {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.PowerCost'}}
    {{#*inline "item-field-inputs"}}
    {{numberInput system.powerCost name="system.powerCost" min=0 step=1}}
    {{/inline}}
    {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

    {{!-- Power Incease --}}
    {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.PowerIncrease'}}
    {{#*inline "item-field-inputs"}}
    <input type="checkbox" name="system.hasVariableCost" {{checked system.hasVariableCost}} />
    {{/inline}}
    {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

    {{#if system.hasVariableCost}}
      {{!-- Max Power Cost --}}
      {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.PowerMaxCost'}}
      {{#*inline "item-field-inputs"}}
      {{numberInput system.maxPowerCost name="system.maxPowerCost" min=0 step=1}}
      {{/inline}}
      {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}
    {{/if}}
    {{!-- Action cost - see templates/item/parts/activation-fields.hbs --}}
    {{> "systems/essence20/templates/item/parts/activation-fields.hbs"}}

    {{!-- Uses Per Scene --}}
    {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.PowerUsesPer'}}
    {{#*inline "item-field-inputs"}}
    {{numberInput system.usesPer name="system.usesPer" min=0 step=1}}
    <select name="system.usesInterval">
      {{selectOptions config.usesInterval selected=system.usesInterval}}
    </select>
    {{/inline}}
    {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

    {{!-- Area of Effect shape + radius. Inside the canActivate block deliberately: a passive,
          always-on Power (canActivate false, no click) never places a shape. --}}
    {{> "systems/essence20/templates/item/parts/aoe-fields.hbs"}}

    {{!-- Duration --}}
    {{> "systems/essence20/templates/item/parts/duration-fields.hbs"}}

    {{!-- Attack Powers only (the Sorcerous attack Powers). Leave the Skill and Defense blank and
          the Power isn't rolled at all, which is right for the Grid Power majority. --}}
    {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.PowerAttackSkill'}}
    {{#*inline "item-field-inputs"}}
    <select class="item-field-inputs" name="system.attackSkill">
      {{selectOptions config.skills selected=system.attackSkill blank=(localize 'E20.None')}}
    </select>
    {{/inline}}
    {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

    {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.SpellDefenseType'}}
    {{#*inline "item-field-inputs"}}
    <select class="item-field-inputs" name="system.defenseType">
      {{selectOptions config.defenses selected=system.defenseType localize=true blank=(localize 'E20.None')}}
    </select>
    {{/inline}}
    {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

    {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.Damage'}}
    {{#*inline "item-field-inputs"}}
    {{numberInput system.damageValue name="system.damageValue" min=0 step=1}}
    <select name="system.damageType">
      {{selectOptions config.damageTypes selected=system.damageType localize=true blank=(localize 'E20.None')}}
    </select>
    {{/inline}}
    {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{/if}}
</div>
