<div>

  {{!-- Action cost - see templates/item/parts/activation-fields.hbs --}}
  {{> "systems/essence20/templates/item/parts/activation-fields.hbs"}}
  {{!-- Form (MLP CRB p.141): scroll (a Spellcasting test), potion (no test, no cost), talisman (no test,
        the spell's cost as a downshift) - documents/item.mjs's magicBauble branch. --}}
  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.MagicBaubleForm'}}
  {{#*inline "item-field-inputs"}}
  <select name="system.form">
    {{selectOptions config.baubleForms selected=system.form}}
  </select>
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{#if (eq system.form 'talisman')}}
  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.MagicBaubleCastingCost'}}
  {{#*inline "item-field-inputs"}}
  {{numberInput system.castingCost name="system.castingCost" min=0 step=1}}
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}
  {{/if}}

  {{!-- Magic Bauble Spellcasting --}}
  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.MagicBaubleSpellcastingShift'}}
  {{#*inline "item-field-inputs"}}
  <select name="system.spellcastingShift">
    {{selectOptions config.skillShifts selected=system.spellcastingShift}}
  </select>
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{!-- Quantity Section --}}
  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.MagicBaubleQuantity'}}
  {{#*inline "item-field-inputs"}}
  {{numberInput system.quantity name="system.quantity" min=0 step=1}}
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{!-- Duration Section --}}
  {{> "systems/essence20/templates/item/parts/duration-fields.hbs"}}

  {{!-- Range Section --}}
  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.MagicBaubleRange'}}
  {{#*inline "item-field-inputs"}}
  <input type="text" name="system.range" value="{{system.range}}" />
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{!-- A bauble made from an attack or area spell keeps its attack (same fields as a spell). --}}
  {{> "systems/essence20/templates/item/parts/aoe-fields.hbs"}}

  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.SpellDefenseType'}}
  {{#*inline "item-field-inputs"}}
  <select class="item-field-inputs" name="system.defenseType">
    {{selectOptions config.defenses selected=system.defenseType localize=true blank=(localize 'E20.None')}}
  </select>
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.Damage'}}
  {{#*inline "item-field-inputs"}}
  {{numberInput system.damageValue name="system.damageValue" min=0 step=1}}
  <select name="system.damageType">
    {{selectOptions config.damageTypes selected=system.damageType localize=true blank=(localize 'E20.None')}}
  </select>
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}
<div>

