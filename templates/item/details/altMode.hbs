<div>
  {{!-- Alt Mode Movement Aerial --}}
  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.AltModeMovementAerial'}}
  {{#*inline "item-field-inputs"}}
  {{numberInput system.altModeMovement.aerial name="system.altModeMovement.aerial" min=0 step=5}}
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{!-- Alt Movement Aquatic --}}
  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.AltModeMovementAquatic'}}
  {{#*inline "item-field-inputs"}}
  {{numberInput system.altModeMovement.aquatic name="system.altModeMovement.aquatic" min=0 step=5}}
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{!-- Alt Movement Ground --}}
  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.AltModeMovementGround'}}
  {{#*inline "item-field-inputs"}}
  {{numberInput system.altModeMovement.ground name="system.altModeMovement.ground" min=0 step=5}}
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.AltModeMovementClimb'}}
  {{#*inline "item-field-inputs"}}
  {{numberInput system.altModeMovement.climb name="system.altModeMovement.climb" min=0 step=5}}
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.AltModeMovementBurrow'}}
  {{#*inline "item-field-inputs"}}
  {{numberInput system.altModeMovement.burrow name="system.altModeMovement.burrow" min=0 step=5}}
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{!-- Alt Mode Size: the sizes it can be, set with the selector - one is its size, two or more a choice (asked when
       the Origin is added, changeable on the actor's Alt Mode row). data/item/alt-mode.mjs keeps its size among them. --}}
  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.AltModeSize'}}
  {{#*inline "item-field-edit"}}
    <a class="trait-selector" data-action="traitSelector" data-options="actorSizes" data-target="system.altModeSizeOptions" data-tooltip="{{localize 'E20.SizeChoicesTooltip'}}">
      <i class="fas fa-edit"></i>
    </a>
  {{/inline}}
  {{#*inline "item-field-inputs"}}
    <div class="chip-section">
      {{#each system.altModeSizeOptions as |size|}}
      <span class="chip">{{lookup @root.config.actorSizes size}}</span>
      {{/each}}
    </div>
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{!-- Bot Mode Size: the sizes it can be, set with the selector - one is its size, two or more a choice (asked when
       the Origin is added, changeable on the actor's Alt Mode row). data/item/alt-mode.mjs keeps its size among them. --}}
  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.BotModeSize'}}
  {{#*inline "item-field-edit"}}
    <a class="trait-selector" data-action="traitSelector" data-options="actorSizes" data-target="system.botModeSizeOptions" data-tooltip="{{localize 'E20.SizeChoicesTooltip'}}">
      <i class="fas fa-edit"></i>
    </a>
  {{/inline}}
  {{#*inline "item-field-inputs"}}
    <div class="chip-section">
      {{#each system.botModeSizeOptions as |size|}}
      <span class="chip">{{lookup @root.config.actorSizes size}}</span>
      {{/each}}
    </div>
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{!-- Alt Mode Crew --}}
  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.AltModeCrew'}}
  {{#*inline "item-field-inputs"}}
  {{numberInput system.altModeCrew name="system.altModeCrew" min=0 step=1}}
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{!-- Alt Mode Firepoints --}}
  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.AltModeFirepoints'}}
  {{#*inline "item-field-inputs"}}
  {{numberInput system.altModeFirepoints name="system.altModeFirepoints" min=0 step=1}}
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.AltModeTokenImage'}}
  {{#*inline "item-field-inputs"}}
  <file-picker id="system.tokenImage" name="system.tokenImage" spellcheck="false">{{system.tokenImage}}</file-picker>
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

