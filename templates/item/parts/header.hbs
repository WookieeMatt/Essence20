<header class="sheet-header item-sheet-header">
  <div class="flexcol e20-flex-grow-0175 e20-gap-5">
    <img class="profile-img item-profile-img" src="{{document.img}}" data-action="editImage" data-edit="img" data-tooltip="{{localize 'E20.ChangeImage'}}"/>
  </div>
  <div class="flexcol e20-flex-grow-1">
    <span class="item-type-badge">{{localize (concat "TYPES.Item." document.type)}}</span>
    <h1 class="charname flexrow"><input name="name" type="text" value="{{document.name}}" placeholder="Name"/></h1>
  </div>
</header>
