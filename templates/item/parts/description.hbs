{{!-- Source --}}
<section class="tab description{{#if (eq activeTab 'description')}} active{{/if}}" data-tab="description" data-group="primary">
{{log activeTab}}
  <div>
    {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.ItemSource'}}
    {{#*inline "item-field-inputs"}}
    <input type="text" name="system.source.book" value="{{system.source.book}}" placeholder="{{localize 'E20.ItemSourceBook'}}"/>
    <input class="two-digit-input" type="number" name="system.source.page" value="{{system.source.page}}" placeholder="{{localize 'E20.ItemSourcePage'}}" min="0" step="1"/>
    {{/inline}}
    {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

    {{!-- Description --}}
    <h3>{{localize 'E20.ItemDescription'}}</h3>
    <div class="description flexcol active">
      {{#if editingDescription}}
        <prose-mirror name="system.description" value="{{ system.description }}" document-uuid="{{ document.uuid }}" class="sized" compact></prose-mirror>
      {{else}}
        <button type="button" class="unbutton control-button always-interactive" data-action="editDescription" label="edit" data-target="system.description">
          <i class="fas fa-edit" inert></i>
        </button>
        {{{system.description}}}
      {{/if}}
    </div>
    {{#if (eq document.type 'equipmentPackage')}}
      {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.AlternateAccess'}}
      {{#*inline "item-field-inputs"}}
      <input type="text" name="system.alternateAccess" value="{{system.alternateAccess}}" />
      {{/inline}}
      {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}
    {{/if}}
  </div>
<section>
