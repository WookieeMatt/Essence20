{{#> "systems/essence20/templates/item/parts/sheet-field.hbs" className=className label=label items=items type=type}}
{{#*inline "item-field-inputs"}}
{{#itemsContainType items type}}
  <div class="flexcol data-drop">
    {{#each items as |item|}}
      {{#if (eq item.type ../type)}}
      <div class="flexrow {{item.type}}" data-item-key="{{@key}}" data-item-uuid="{{item.uuid}}">
        <ul class="items-list">
          <li class="item">
          <div class="flexrow align-center nowrap">
            <label class="flexcol">{{item.name}}</label>
            <div class="item-controls">
              <a class="view-info" data-action="viewItem" data-uuid="{{item.uuid}}" data-tooltip="{{localize 'E20.OpenItem'}}">
                <i class="fa-solid fa-fw fa-info-circle"></i>
              </a>
              <a class="item-control flex-right" data-action="deleteItem" data-item-key="{{@key}}" data-type="{{../className}}" data-tooltip="{{localize 'E20.DeleteItem'}}">
                <i class="fas fa-trash"></i>
              </a>
            </div>
          </div>
          </li>
        </ul>
      </div>
      {{/if}}
    {{/each}}
  </div>
{{else}}
  <label>{{localize "E20.ItemDrop" type=(localize (concat "TYPES.Item." type))}}</label>
{{/itemsContainType}}
{{/inline}}
{{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}
