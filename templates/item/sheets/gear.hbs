<section class="tab details flexcol" data-group="primary" data-tab="details">
  {{!-- Gear Type --}}
  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.GearType'}}
  {{#*inline "item-field-inputs"}}
  <select name="system.gearType">
    {{selectOptions @root.config.gearTypes selected=system.gearType}}
  </select>
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}

  {{#> "systems/essence20/templates/item/parts/sheet-field.hbs" label='E20.GearQuantity'}}
  {{#*inline "item-field-inputs"}}
  {{numberInput system.quantity name="system.quantity" min=0 step=1}}
  {{/inline}}
  {{/"systems/essence20/templates/item/parts/sheet-field.hbs"}}
</section>
