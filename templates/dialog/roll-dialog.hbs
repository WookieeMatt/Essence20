  <div class="roll-dialog-hardpoint-move">
    <span>{{localize 'E20.RollDialogHardpointMove'}}</span>
    <select name="hardpointMovePenalty">
      {{#if hardpointMovement.reinforced}}
        <option value="0">{{localize 'E20.RollDialogHardpointMoveUpTo'}}</option>
        <option value="1">{{localize 'E20.RollDialogHardpointMoveBeyond'}} (&darr;1)</option>
      {{else}}
        <option value="0">{{localize 'E20.RollDialogHardpointMoveNone'}}</option>
        <option value="1">{{localize 'E20.RollDialogHardpointMoveUpTo'}} (&darr;1)</option>
        <option value="2">{{localize 'E20.RollDialogHardpointMoveBeyond'}} (&darr;2)</option>
      {{/if}}
    </select>
  </div>
  {{/if}}

