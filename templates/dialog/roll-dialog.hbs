<div class="roll-dialog">
  <div class="flexrow roll-dialog-shift-row">
    <div class="flexcol">
      {{localize 'E20.ShiftUp'}}
      <input class="roll-dialog-shift-input" type="number" name="shiftUp" value={{shiftUp}} min="0" max="99" step="1" />
    </div>
    <div class="flexcol">
      {{localize 'E20.ShiftDown'}}
      <input class="roll-dialog-shift-input" type="number" name="shiftDown" value={{shiftDown}} min="0" max="99" step="1" />
    </div>
  </div>

  <div class="flexrow roll-dialog-snag-edge-row">
    <label><input type="radio" name="snagEdge" value="snag" data-dtype="String" {{checked snag}} /> {{localize 'E20.RollDialogSnag'}}</label>
    <label><input type="radio" name="snagEdge" value="normal" data-dtype="String" {{checked normal}} /> {{localize 'E20.RollDialogNormal'}}</label>
    <label><input type="radio" name="snagEdge" value="edge" data-dtype="String" {{checked edge}} /> {{localize 'E20.RollDialogEdge'}}</label>
  </div>

  <div class="flexrow align-center roll-dialog-toggle">
    <span>{{localize 'E20.RollIsSpecialized'}}</span>
    <label class="switch">
      <input type="checkbox" name="isSpecialized" {{checked isSpecialized}} />
      <span class="switch-slider"></span>
    </label>
  </div>

  <div class="flexrow align-center roll-dialog-toggle">
    <span>{{localize 'E20.RollCanCritD2'}}</span>
    <label class="switch">
      <input type="checkbox" name="canCritD2" {{checked canCritD2}} />
      <span class="switch-slider"></span>
    </label>
  </div>

  {{#if aimBonus}}
  <div class="flexrow align-center roll-dialog-toggle">
    <span>{{localize 'E20.RollDialogAiming'}} (+{{aimBonus}})</span>
    <label class="switch">
      <input type="checkbox" name="isAiming" />
      <span class="switch-slider"></span>
    </label>
  </div>
  {{/if}}

  {{#if energonAvailable}}
  <div class="flexrow align-center roll-dialog-toggle">
    <span>{{localize 'E20.RollDialogEnergon'}} (+1)</span>
    <label class="switch">
      <input type="checkbox" name="spendEnergon" />
      <span class="switch-slider"></span>
    </label>
  </div>
  {{/if}}

  {{#if akimboAvailable}}
  <div class="flexrow align-center roll-dialog-toggle">
    <span>{{localize 'E20.RollDialogAkimbo'}}</span>
    <label class="switch">
      <input type="checkbox" name="akimbo" />
      <span class="switch-slider"></span>
    </label>
  </div>
  {{/if}}

  {{#if alphaStrikeAvailable}}
  <div class="flexrow align-center roll-dialog-toggle">
    <span>{{localize 'E20.RollDialogAlphaStrike'}}</span>
    <label class="switch">
      <input type="checkbox" name="alphaStrike" />
      <span class="switch-slider"></span>
    </label>
  </div>
  {{/if}}

  {{#if emptyTheMagAvailable}}
  <div class="flexrow align-center roll-dialog-toggle">
    <span>{{localize 'E20.RollDialogEmptyTheMag'}}</span>
    <label class="switch">
      <input type="checkbox" name="emptyTheMag" />
      <span class="switch-slider"></span>
    </label>
  </div>
  {{/if}}

  {{#if drivingStrikeAvailable}}
  <div class="flexrow align-center roll-dialog-toggle">
    <span>{{localize 'E20.RollDialogDrivingStrike'}} (1 {{localize 'E20.PowerRangerPersonalPower'}})</span>
    <select name="drivingStrike">
      <option value="none">{{localize 'E20.None'}}</option>
      <option value="reroll">{{localize 'E20.DrivingStrikeReroll'}}</option>
      <option value="ignoreArmor">{{localize 'E20.DrivingStrikeIgnoreArmor'}}</option>
    </select>
  </div>
  {{/if}}

  {{#if rolePoints}}
  <div class="flexrow align-center">
    <input type="checkbox" name="applyRolePointsUpshift" {{checked applyRolePointsUpshift}} />
    Apply {{rolePoints.name}} to gain {{rolePoints.system.bonus.value}}<i class="fas fa-arrow-up flex-grow-0"></i>?
  </div>
  {{/if}}

  {{#if damageRolePoints}}
  <div class="flexrow align-center roll-dialog-toggle">
    <span>{{localize 'E20.RollDialogApplyDamageBonus' name=damageRolePoints.name value=damageRolePoints.value}}</span>
    <label class="switch">
      <input type="checkbox" name="applyRolePointsDamage" {{checked damageRolePoints.autoEligible}} />
      <span class="switch-slider"></span>
    </label>
  </div>
  {{#if damageRolePoints.autoReason}}
  <div class="roll-dialog-role-points-reason">{{damageRolePoints.autoReason}}</div>
  {{/if}}

  {{#if damageRolePoints.canDouble}}
  <div class="flexrow align-center roll-dialog-toggle">
    <span>{{localize 'E20.RollDialogApplyDamageDouble'}}</span>
    <label class="switch">
      <input type="checkbox" name="applyDamageDouble" />
      <span class="switch-slider"></span>
    </label>
  </div>
  {{/if}}
  {{/if}}

  <div>
    {{localize 'E20.RollDialogDefenseType'}}
    <select name="defenseType">
      {{selectOptions defenseTypes selected=defenseType localize=true}}
    </select>
  </div>
</div>
