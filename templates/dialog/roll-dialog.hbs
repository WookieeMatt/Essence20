<div class="roll-dialog">
  <div class="flexrow roll-dialog-shift-row">
    <div class="flexcol">
      {{localize 'E20.ShiftUp'}}
      <input class="roll-dialog-shift-input" type="number" name="shiftUp" value={{shiftUp}} min="0" max="99" step="1" />
    </div>
    <div class="flexcol">
      {{localize 'E20.ShiftDown'}}
      <input class="roll-dialog-shift-input" type="number" name="shiftDown" value={{shiftDown}} min="0" max="99" step="1" />
    </div>
  </div>

  <div class="flexrow roll-dialog-snag-edge-row">
    <label><input type="radio" name="snagEdge" value="snag" data-dtype="String" {{checked snag}} /> {{localize 'E20.RollDialogSnag'}}{{#if snagSourcesText}} ({{snagSourcesText}}){{/if}}</label>
    <label><input type="radio" name="snagEdge" value="normal" data-dtype="String" {{checked normal}} /> {{localize 'E20.RollDialogNormal'}}</label>
    <label><input type="radio" name="snagEdge" value="edge" data-dtype="String" {{checked edge}} /> {{localize 'E20.RollDialogEdge'}}{{#if edgeSourcesText}} ({{edgeSourcesText}}){{/if}}</label>
  </div>

  {{#if shiftModifierSources.length}}
  <div class="roll-dialog-modifier-sources">
    <span>{{localize 'E20.RollDialogAutomaticModifiers'}}</span>
    {{#each shiftModifierSources}}
    <div class="flexrow align-center roll-dialog-toggle">
      <span>
        {{label}}
        {{#if shiftUp}}(<i class="fas fa-arrow-up"></i> {{shiftUp}}){{/if}}
        {{#if shiftDown}}(<i class="fas fa-arrow-down"></i> {{shiftDown}}){{/if}}
      </span>
      <label class="switch">
        <input type="checkbox" name="combatModifierSource-{{id}}" checked="checked" />
        <span class="switch-slider"></span>
      </label>
    </div>
    {{/each}}
  </div>
  {{/if}}

  <div class="flexrow align-center roll-dialog-toggle">
    <span>{{localize 'E20.RollIsSpecialized'}}</span>
    <label class="switch">
      <input type="checkbox" name="isSpecialized" {{checked isSpecialized}} />
      <span class="switch-slider"></span>
    </label>
  </div>

  <div class="flexrow align-center roll-dialog-toggle">
    <span>{{localize 'E20.RollCanCritD2'}}</span>
    <label class="switch">
      <input type="checkbox" name="canCritD2" {{checked canCritD2}} />
      <span class="switch-slider"></span>
    </label>
  </div>

