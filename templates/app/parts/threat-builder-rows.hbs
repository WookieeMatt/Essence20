{{!-- Threat Builder: a list of new Perks, Powers or Hang-Ups typed in by hand (apps/threat-builder.mjs). --}}
<fieldset class="threat-builder-rows">
  <legend>{{label}}{{#if type}} <a class="threat-builder-browse" data-action="openCompendium" data-type="{{type}}" data-tooltip="{{localize 'E20.CompendiumBrowserOpenFor'}}" aria-label="{{localize 'E20.CompendiumBrowserOpenFor'}}"><i class="fa-solid fa-magnifying-glass" inert></i></a>{{/if}}</legend>
  {{#each rows as |row i|}}
    <div class="threat-builder-newitem">
      <input type="text" name="{{../list}}.{{i}}.name" value="{{row.name}}" placeholder="{{localize 'E20.ThreatBuilderItemName'}}">
      {{#if ../power}}
        <select name="{{../list}}.{{i}}.actionType" aria-label="{{localize 'E20.ThreatBuilderAction'}}">{{selectOptions ../actionChoices selected=row.actionType}}</select>
      {{/if}}
      <textarea name="{{../list}}.{{i}}.text" rows="2" placeholder="{{localize 'E20.ThreatBuilderItemText'}}">{{row.text}}</textarea>
      <button type="button" class="icon" data-action="removeRow" data-list="{{../list}}" data-index="{{i}}" aria-label="{{localize 'Remove'}}"><i class="fa-solid fa-xmark" inert></i></button>
    </div>
  {{/each}}
  <button type="button" data-action="addRow" data-list="{{list}}"><i class="fa-solid fa-plus" inert></i> {{label}}</button>
</fieldset>
