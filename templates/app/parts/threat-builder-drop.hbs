{{!-- Threat Builder: a drop zone for compendium or world Items, added through the sheet's own drop handling on Create. --}}
<div class="threat-builder-drop" data-zone="{{zone}}">
  <p class="hint"><i class="fa-solid fa-hand-pointer" inert></i> {{hint}}</p>
  <ul class="threat-builder-list">
    {{#each rows as |row|}}
      {{#if (eq row.zone ../zone)}}
        <li><img src="{{row.img}}" alt="" width="24" height="24"><span>{{row.name}}</span><span class="type">{{row.typeLabel}}</span>
          <button type="button" class="icon" data-action="removeRow" data-list="dropped" data-index="{{row.index}}" aria-label="{{localize 'Remove'}}"><i class="fa-solid fa-xmark" inert></i></button></li>
      {{/if}}
    {{/each}}
  </ul>
</div>
