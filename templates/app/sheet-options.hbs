<div class="trait-selector flexcol">
  {{!-- NPC / Contact moved to the NPC sheet header's buttons (headers/npc.hbs). --}}
  {{#if (ne role.system.version 'powerRanger')}}
    {{#> "systems/essence20/templates/app/parts/field.hbs" label='E20.CanMorph'}}
    {{#*inline "field-inputs"}}
      <input type="checkbox" id="canMorph" name="system.canMorph" {{checked system.canMorph}} />
    {{/inline}}
    {{/"systems/essence20/templates/app/parts/field.hbs"}}
  {{/if}}

  {{#if (ne role.system.version 'myLittlePony')}}
    {{#> "systems/essence20/templates/app/parts/field.hbs" label='E20.CanSpellcast'}}
    {{#*inline "field-inputs"}}
      <input type="checkbox" id="canSpellcast" name="system.canSpellcast" {{checked system.canSpellcast}}/>
    {{/inline}}
    {{/"systems/essence20/templates/app/parts/field.hbs"}}
  {{/if}}

  {{#unless altMode}}
    {{#> "systems/essence20/templates/app/parts/field.hbs" label='E20.CanTransform'}}
    {{#*inline "field-inputs"}}
      <input type="checkbox" id="canTransform" name="system.canTransform" {{checked system.canTransform}}/>
    {{/inline}}
    {{/"systems/essence20/templates/app/parts/field.hbs"}}
  {{/unless}}

  {{#> "systems/essence20/templates/app/parts/field.hbs" label='E20.CanUseWeird'}}
  {{#*inline "field-inputs"}}
    <input type="checkbox" id="canUseWeird" name="system.canUseWeird" {{checked system.canUseWeird}}/>
  {{/inline}}
  {{/"systems/essence20/templates/app/parts/field.hbs"}}

  {{!-- Only the two sheets that render a Wealth Die. It was offered on every actor type, which
       meant ticking it on a Companion, vehicle or Zord did nothing at all - and those last two
       do not even carry the field, since it comes from data/actor/templates/character.mjs. --}}
  {{#if (or (eq actor.type "playerCharacter") (eq actor.type "npc"))}}
    {{#> "systems/essence20/templates/app/parts/field.hbs" label='E20.CanShowWealthDie'}}
    {{#*inline "field-inputs"}}
      <input type="checkbox" id="canShowWealthDie" name="system.canShowWealthDie" {{checked system.canShowWealthDie}}/>
    {{/inline}}
    {{/"systems/essence20/templates/app/parts/field.hbs"}}
  {{/if}}

  {{#if system.canMorph}}
    <div class="flexrow">
      <label for="system.image.morphed">{{localize 'E20.MorphedImage'}}</label>
      <file-picker id="system.image.morphed" name="system.image.morphed" spellcheck="false">{{system.image.morphed}}</file-picker>
    </div>
  {{/if}}
</div>
