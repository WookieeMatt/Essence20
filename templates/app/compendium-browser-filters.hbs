<div class="compendium-browser-filters flexcol">
  <search>
    <input type="search" name="search" value="{{search}}" placeholder="{{localize 'E20.CompendiumBrowserSearchPlaceholder'}}" />
  </search>

  {{#if isGM}}
    <button type="button" class="compendium-browser-configure-sources" data-action="configureSources">
      <i class="fa-solid fa-book-atlas"></i>
      <span>{{localize "E20.CompendiumBrowserConfigureSources"}}</span>
    </button>
  {{/if}}

  {{#if subtypeFilter}}
    <fieldset class="compendium-browser-filter-group">
      <legend>{{subtypeFilter.label}}</legend>
      <div class="compendium-browser-filter-actions">
        <a data-action="selectAllSubtypes">{{localize "E20.CompendiumBrowserSelectAll"}}</a>
        <a data-action="selectNoSubtypes">{{localize "E20.CompendiumBrowserSelectNone"}}</a>
      </div>
      {{#each subtypeFilter.options as |opt|}}
        <label class="compendium-browser-filter-option">
          <input type="checkbox" data-subtype="{{opt.key}}" {{checked opt.checked}} />
          <span>{{opt.label}}</span>
        </label>
      {{/each}}
    </fieldset>
  {{/if}}

  <details class="compendium-browser-filter-group compendium-browser-books-group" {{#if booksExpanded}}open{{/if}}>
    <summary>{{localize "E20.CompendiumBrowserFilterBooks"}}</summary>
    <div class="compendium-browser-filter-actions">
      <a data-action="selectAllBooks">{{localize "E20.CompendiumBrowserSelectAll"}}</a>
      <a data-action="selectNoBooks">{{localize "E20.CompendiumBrowserSelectNone"}}</a>
    </div>
    {{#each groups as |group|}}
      <div class="compendium-browser-filter-subgroup">
        <div class="compendium-browser-filter-subgroup-header">
          <span class="compendium-browser-filter-subgroup-label">{{group.name}}</span>
          <span class="compendium-browser-filter-actions">
            <a data-action="selectAllBooksInGroup" data-group="{{group.name}}">{{localize "E20.CompendiumBrowserSelectAll"}}</a>
            <a data-action="selectNoBooksInGroup" data-group="{{group.name}}">{{localize "E20.CompendiumBrowserSelectNone"}}</a>
          </span>
        </div>
        {{#each group.packs as |pack|}}
          <label class="compendium-browser-filter-option">
            <input type="checkbox" data-pack-id="{{pack.id}}" {{checked pack.checked}} />
            <span>{{pack.label}}</span>
          </label>
        {{/each}}
      </div>
    {{/each}}
  </details>
</div>
