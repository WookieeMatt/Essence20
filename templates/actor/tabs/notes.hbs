<section class="tab notes {{tabs.notes.cssClass}}" data-tab="notes" data-group="primary">
  {{!-- Vehicle-only for now - moved off the Main tab, which was getting crowded. --}}
  {{#if (eq @root.document.type 'vehicle')}}
  <div class="npc-firepoints">
    {{!-- Firepoint Descriptions --}}
    <div class="stats-container firepoints">
      <textarea class="firepoints-input" oninput='this.style.height = "";this.style.height = this.scrollHeight + "px"'
       name="system.firepoints.description" placeholder="{{localize 'E20.VehicleFirepointsDescription'}}">{{system.firepoints.description}}</textarea>
    </div>
  </div>
  {{/if}}

  <div class="notes-container e20-border-accent">
    {{!-- The {{editor}} Handlebars helper emits the legacy .editor-edit/.editor-content markup,
         whose click-to-edit activation is wired up by FormApplication (appv1) only - it's dead
         weight on an ApplicationV2 sheet like this one, so the pencil button did nothing.
         <prose-mirror> (used the same way on the Item sheet's own Description tab,
         item/tabs/description.hbs) is the ApplicationV2-native replacement: a self-contained
         custom element that activates its own toggle button, editor, and form-value binding
         with no extra JS required here. --}}
    <prose-mirror name="system.notes" value="{{system.notes}}" document-uuid="{{document.uuid}}" toggled></prose-mirror>
  </div>
</section>
