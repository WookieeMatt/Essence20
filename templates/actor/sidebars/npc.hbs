<section class="essence20-sidebar sheet-header">
  {{!-- Profile image --}}
  <img class="profile-img" style="border-color: {{system.color}};" src="{{document.img}}" data-action="editImage" data-edit="img" data-tooltip="{{localize 'E20.ChangeImage'}}" />

  <div class="sliced-border --col essence20-sidebar-panel essence20-sidebar-resources">
    <a class="sliced-border__label sliced-border__label--clickable" data-action="editHealth" data-tooltip="{{localize 'E20.StatEditorHealthTooltip'}}"><i class="fas fa-heart"></i> Resources <i class="fas fa-gear sliced-border__label-edit-icon"></i></a>
    {{> "systems/essence20/templates/actor/parts/misc/sidebar-health.hbs"}}
    <div>
      <label>{{localize 'E20.ActorStun'}}</label>
      <input class="two-digit-input no-lock" type="number" name="system.stun.value" value="{{system.stun.value}}" min="0" step="1" />
      <span>/</span>
      <span class="sidebar-readout">{{system.health.value}}</span>
    </div>
    {{!-- The same resources a character's sidebar shows, when the NPC has them (Can Transform / Can Morph in the
         header's Sheet Options). Energon used to sit only on the Alt Mode tab and Personal Power nowhere; the Alt
         Mode tab now leaves Energon to this panel (npc-altmode.hbs, hideNormal - two inputs of one name break every
         save). A transforming NPC's maximum is its lowest Essence (documents/actor.mjs#_prepareEnergon), so it's
         shown, not typed; one with a pool but no Transform (Organic Energon) types its own. --}}
    {{#if (or system.canTransform system.energon.normal.max)}}
    <div>
      <label>{{localize "E20.Energon"}}</label>
      <input class="two-digit-input no-lock" data-field="system.energon.normal.value" type="number"
        name="system.energon.normal.value" value="{{system.energon.normal.value}}" min="0" step="1" />
      <span>/</span>
      {{#if system.canTransform}}
      <span class="sidebar-readout" data-tooltip="{{localize 'E20.EnergonMaxTooltip'}}">{{system.energon.normal.max}}</span>
      {{else}}
      <input class="two-digit-input no-lock" data-field="system.energon.normal.max" type="number" name="system.energon.normal.max"
        value="{{system.energon.normal.max}}" min="0" step="1" />
      {{/if}}
    </div>
    {{/if}}
    {{#if system.canMorph}}
    <div>
      <label>{{localize "E20.PowerRangerPersonalPower"}}</label>
      <input class="two-digit-input no-lock" data-field="system.powers.personal.value" type="number"
        name="system.powers.personal.value" value="{{system.powers.personal.value}}" min="0" step="1" />
      <span>/</span>
      <input class="two-digit-input no-lock" data-field="system.powers.personal.max" type="number" name="system.powers.personal.max"
        value="{{system.powers.personal.max}}" min="0" step="1" />
    </div>
    {{/if}}
    {{#if system.powers.sorcerous.levelTaken}}
    <div>
      <label>{{localize "E20.SorcerousPower"}}</label>
      <span class="two-digit-input{{#if (gt system.powers.sorcerous.committed system.powers.sorcerous.max)}} is-over{{/if}}"
        data-tooltip="{{localize 'E20.SorcerousPowerCommittedHint'}}">{{system.powers.sorcerous.committed}}</span>
      <span>/</span>
      <input class="two-digit-input no-lock" data-field="system.powers.sorcerous.max" type="number" name="system.powers.sorcerous.max"
        value="{{system.powers.sorcerous.max}}" min="0" step="1" />
    </div>
    {{/if}}

    {{!-- Rest / Recharge restores what this panel tracks, as on a character. --}}
    {{#if system.canTransform}}
      <a class="essence20-sidebar-action-button" data-action="recharge" data-tooltip="{{localize "E20.RechargeButtonTitle"}}">
        <i class="fas fa-charging-station"></i>
        {{localize "E20.RechargeButtonTitle"}}
      </a>
    {{else}}
      <a class="essence20-sidebar-action-button" data-action="rest" data-tooltip="{{localize "E20.RestButtonTitle"}}">
        <i class="fas fa-face-sleeping"></i>
        {{localize "E20.RestButtonTitle"}}
      </a>
    {{/if}}
  </div>
  <div class="sliced-border --col essence20-sidebar-panel essence20-sidebar-special">
    <label class="sliced-border__label"><i class="fas fa-bolt"></i> Special</label>
    <div class="essence20-sidebar-action-button essence20-sidebar-initiative">
      <div class="item-image">
        <a class="rollable" data-action="rollable" data-roll-type="initiative"><i class="fas fa-dice-d20" data-roll-type="initiative"></i></a>
      </div>
      <select name="system.initiative.skill">
        {{selectOptions @root.initiativeSkills selected=system.initiative.skill valueAttr="key" labelAttr="label"}}
      </select>
      {{!-- Display only: the shift die is set on the skill itself, not editable from here --}}
      <span data-tooltip="{{localize 'E20.InitiativeShiftTooltip'}}">
        {{localize (lookup @root.config.skillShifts (lookup (lookup system.skills system.initiative.skill) 'shift'))}}
      </span>
    </div>
    {{> "systems/essence20/templates/actor/parts/misc/sidebar-transform-morph.hbs"}}

    {{!-- Wealth Die. Off by default and switched on from the sheet options gear in the header
         (system.canShowWealthDie), the same as on a character - where it also lives in the
         sidebar. Beside Initiative because this panel is already where the sheet keeps the dice
         you roll that are not skills in the list.

         Unlike Initiative just above, the shift IS editable here: Wealth is absent from the
         Skill Picker that edits every other NPC skill, so this select is the only place to set
         it. Same markup as the character sidebar, so the two behave identically. --}}
    {{#if system.canShowWealthDie}}
    <div class="essence20-sidebar-wealth flexrow skill-header e20-skill-header" data-e20-color="{{system.color}}">
      <a class="rollable skill-name" data-action="rollable" data-roll-type="skill" data-skill="wealth"
        data-shift-up="{{system.skills.wealth.shiftUp}}" data-shift-down="{{system.skills.wealth.shiftDown}}"
        data-shift="{{system.skills.wealth.shift}}" data-is-specialized="{{system.skills.wealth.isSpecialized}}">
        {{localize 'E20.ActorWealth'}}
      </a>
      <select class="skill-shift-select" name="system.skills.wealth.shift">
        {{selectOptions @root.config.wealthShifts selected=system.skills.wealth.shift}}
      </select>
    </div>
    {{/if}}
  </div>
  {{> "systems/essence20/templates/actor/parts/misc/sidebar-speeds.hbs"}}
  {{> "systems/essence20/templates/actor/parts/misc/sidebar-defenses.hbs"}}
  {{> "systems/essence20/templates/actor/parts/misc/sidebar-immunities-resistances.hbs"}}
</section>
