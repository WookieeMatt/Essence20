<header class="sheet-header e20-border-accent">

  {{!-- Profile image --}}
  <div class="flexcol flex-grow-0175 gap-5">
    <img class="profile-img e20-border-accent" src="{{actor.img}}" data-edit="img" data-tooltip="{{localize 'E20.ChangeImage'}}" />
  </div>

  <div class="flexrow gap-2 header-row-top">
    {{!-- Name --}}
    <div class="header-name-field">
      <div class="sliced-border">
        <label class="sliced-border__label">{{localize 'E20.ActorName'}}</label>
        <h1 class="charname"><input name="name" type="text" value="{{document.name}}" placeholder="Name" /></h1>
      </div>
    </div>

    {{!-- Size --}}
    <div class="sliced-border">
      <label class="sliced-border__label">{{localize 'E20.ActorSize'}}</label>
      {{#if system.isTransformed}}
        <select name="system.altModesize">
          {{selectOptions config.actorSizes selected=system.altModesize}}
        </select>
      {{else}}
        {{#if (eq @root.document.type 'megaform')}}
          {{#inArray system.subtype 'megaformCombiner'}}
            <select name="system.size" disabled>
              {{selectOptions config.actorSizes selected=system.size}}
            </select>
          {{else}}
            <select name="system.size">
              {{selectOptions config.actorSizes selected=system.size}}
            </select>
          {{/inArray}}
        {{else}}
          <select name="system.size">
            {{selectOptions config.actorSizes selected=system.size}}
          </select>
        {{/if}}
      {{/if}}
    </div>

    {{#> topRowFields}}
    {{!-- Custom top-row fields here --}}
    {{/topRowFields}}
  </div>

  <div class="flexrow gap-2 header-row-bottom">
    {{#> secondary-fields}}
    {{!-- Custom secondary fields here --}}
    {{/secondary-fields}}
  </div>
</header>
