{{#>"systems/essence20/templates/actor/headers/common.hbs"}}
{{#*inline "secondary-fields"}}
<div class="sliced-border">
  <label class="sliced-border__label">{{localize 'E20.MegaformSubtype'}}</label>
  <select name="system.subtype">
    {{selectOptions config.megaformSubtypes selected=system.subtype}}
  </select>
</div>
<div class="sliced-border">
  <label class="sliced-border__label">{{localize 'E20.ZordPrerequisite'}}</label>
  <input type="text" name="system.prerequisite" value="{{system.prerequisite}}" />
</div>
<div class="sliced-border">
  <label class="sliced-border__label">{{ localize 'E20.ActorArmor' }}</label>
  {{numberInput system.armor name="system.armor" min=0 step=1}}
</div>
{{/inline}}
{{/"systems/essence20/templates/actor/headers/common.hbs"}}
