{{#>"systems/essence20/templates/actor/headers/common.hbs"}}
{{#*inline "topRowFields"}}
<div class="sliced-border pr-header-color e20-flex-group-center">
  <label class="sliced-border__label">{{localize 'E20.ActorColor'}}</label>
  <input type="color" class="picker" name="system.color" value="{{system.color}}" />
</div>
<div class="sliced-border pr-header-level">
  <label class="sliced-border__label">{{localize 'E20.ActorLevel'}}</label>
  <div class="flexrow e20-align-center e20-gap-2">
    {{numberInput system.level name="system.level" min=0 step=1 class="two-digit-input"}}
  </div>
</div>
{{/inline}}
{{#*inline "secondary-fields"}}
<div class="sliced-border --col">
  {{> "systems/essence20/templates/actor/parts/items/role.hbs"}}
</div>
{{#inArray '["giJoe", "transformers"]' @root.role.system.version}}
  <div class="sliced-border --col">
    {{> "systems/essence20/templates/actor/parts/items/focus.hbs"}}
  </div>
{{/inArray}}
<div class="sliced-border --col">
  {{> "systems/essence20/templates/actor/parts/items/faction.hbs"}}
</div>
{{/inline}}
{{/"systems/essence20/templates/actor/headers/common.hbs"}}
