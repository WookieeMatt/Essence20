{{#>"systems/essence20/templates/actor/headers/common.hbs"}}
{{#*inline "secondary-fields"}}
<div class="sliced-border">
  <label class="sliced-border__label">{{localize 'E20.ZordPrerequisite'}}</label>
  <input type="text" name="system.prerequisite" value="{{system.prerequisite}}" />
</div>
<div class="sliced-border">
  <label class="sliced-border__label">{{ localize 'E20.ZordRanger' }}</label>
  <input type="text" name="system.ranger" value="{{system.ranger}}" />
</div>
<div class="sliced-border">
  <label class="sliced-border__label">{{ localize 'E20.ActorConditioning' }}</label>
  {{numberInput system.conditioning name="system.conditioning" min=0 step=1}}
</div>
<div class="sliced-border">
  <label class="sliced-border__label">{{ localize 'E20.ActorArmor' }}</label>
  {{numberInput system.armor name="system.armor" min=0 step=1}}
</div>
<div class="sliced-border pr-header-color flex-group-center">
  <label class="sliced-border__label">{{localize 'E20.ActorColor'}}</label>
  <input type="color" class="picker" name="system.color" value="{{system.color}}" />
</div>
<div class="sliced-border">
  <label class="sliced-border__label">{{localize 'E20.MegaformZordCombiner'}}</label>
  <input type="checkbox" name="system.isCombiner" {{checked system.isCombiner}} />
</div>
{{/inline}}
{{/"systems/essence20/templates/actor/headers/common.hbs"}}
