<div
  class="sliced-border flex-group-center"
  style="border-color: {{system.color}}; width: min-content; min-width: 100px;"
>
  <label class="sliced-border__label">
    <a
      class="rest"
      style="flex-grow: 0;"
      data-tooltip="{{localize 'E20.RestButtonTitle'}}"
    ><i class="fas fa-face-sleeping"></i></a>
    <span>{{localize "E20.ActorHealth"}}</span>
  </label>
  <div class="sliced-border__input-row" style="gap: 5px; align-items: center;">
    <input
      class="two-digit-input no-lock"
      type="number"
      name="system.health.value"
      value="{{system.health.value}}"
      min="0"
      step="1"
    />
    <span>/</span>
    {{#if @root.system.movementIsReadOnly}}
      <input
        class="two-digit-input no-unlock"
        type="number"
        name="system.health.max"
        value="{{system.health.max}}"
        title="{{system.health.string}}"
        readonly
      />
    {{else}}
      <input
        class="two-digit-input no-lock"
        type="number"
        name="system.health.max"
        value="{{system.health.max}}"
        min="0"
        step="1"
      />
    {{/if}}
  </div>
</div>