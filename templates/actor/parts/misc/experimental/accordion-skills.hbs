{{!-- TODO: Refactor Accordion to be a bit less dependent on classes, and use data params --}}
<div class="sliced-border --col --fw skills-container accordion-wrapper {{accordionStates.skills}}" style="border-color: {{system.color}};">
  <label class="sliced-border__label accordion-label">
    <span>{{localize 'E20.AccordionSkillsTitle'}}</span>
    <a class="item-control"><i class="accordion-icon fas fa-chevron-down"></i></a>
  </label>

  {{#each @root.config.skillsByEssence as |skills essence|}}
    <div class="skill-separator">{{lookup @root.config.essences essence}}</div>

    {{#each skills as |skill|}}
      {{#if (lookup @root.displayedNpcSkills skill)}}
        <div>
      {{else}}
        <div class="accordion-content">
      {{/if}}

      {{> "systems/essence20/templates/actor/parts/misc/essence-skills.hbs" essence=essence skill=skill fields=(lookup @root.system.skills skill)}}
      </div>
    {{/each}}
  {{/each}}
</div>