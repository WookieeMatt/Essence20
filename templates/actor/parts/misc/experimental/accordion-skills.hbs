<div style="display: flex; flex-direction: column; gap: 16px;">
  {{#each @root.config.skillsByEssence as |skills essence|}}
    <div class="sliced-border --col --fw">
      <span class="sliced-border__label --heading">{{lookup @root.config.essences essence}}</span>

      {{#each skills as |skill|}}
        {{> "systems/essence20/templates/actor/parts/misc/experimental/essence-skill.hbs" essence=essence skill=skill fields=(lookup @root.system.skills skill)}}
      {{/each}}
    </div>
  {{/each}}
</div>