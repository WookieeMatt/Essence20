<div class="zord-combiners">
  <div class="flexrow e20-gap-6">
    {{#if actors}}
      {{#each actors as |attachedActor key|}}
      <div class="systemActors zord item stats-container e20-border-accent" data-e20-color="{{attachedActor.system.color}}" data-system-Actors-uuid="{{attachedActor.uuid}}">
        <div class="flexrow e20-flex-group-center">
          <img class="zord-img" src="{{attachedActor.img}}" data-edit="img" data-tooltip="{{attachedActor.name}}" />
        </div>

        <div class="flexrow e20-align-center e20-gap-6">
          <div class="e20-nowrap">{{ localize 'E20.ActorName' }}: {{attachedActor.name}}</div>

          <div class="item-controls">
            {{!-- Same info button attached ITEMS use (id-drop.hbs/role-perk-drop.hbs) - an explicit
                 control rather than the card-wide double-click this replaced, which had no
                 affordance beyond a cursor change and fought the card's own inputs. --}}
            <a class="view-info" data-action="systemActorOpen" data-uuid="{{attachedActor.uuid}}" data-tooltip="{{localize 'E20.ActorOpenSheetTooltip'}}">
              <i class="fa-solid fa-fw fa-info-circle"></i>
            </a>
            <a class="item-control" data-action="systemActorsDelete" data-system-Actors-uuid="{{attachedActor.uuid}}" data-tooltip="{{localize 'E20.DeleteActor'}}">
              <i class="fas fa-trash" data-system-Actors-uuid="{{attachedActor.uuid}}"></i>
            </a>
          </div>
        </div>
        {{!-- Health - every attached actor type (npc included: an NPC/Contact is still a
             creature() with its own health, per npc.mjs, and a Contact a player fights
             alongside is exactly where seeing it at a glance is most useful) has this. --}}
        <div class="attached-actor-stat">
          <span class="attached-actor-stat-label">{{ localize 'E20.ActorHealth' }}</span>
          <input class="two-digit-input attached-actor-health" type="number" data-system-Actors-uuid="{{attachedActor.uuid}}" value="{{attachedActor.system.health.value}}" min="0" max="{{attachedActor.system.health.max}}" step="1" />
          <span class="attached-actor-stat-max">/ {{attachedActor.system.health.max}}</span>
        </div>
        <div class="attached-actor-stat">
          <span class="attached-actor-stat-label">{{ localize 'E20.ActorStun' }}</span>
          <input class="two-digit-input attached-actor-stun" type="number" data-system-Actors-uuid="{{attachedActor.uuid}}" value="{{attachedActor.system.stun.value}}" min="0" step="1" />
        </div>

        {{#if (eq attachedActor.type "npc")}}
          {{!-- Role/occupation (system.background.role, character.mjs - a free-text field, not
               the item-based Role subsystem PCs use) and how the contact was gained
               (system.gainingTheContact, npc.mjs) are the two fields specific to NPCs that
               actually say something about who this person is, rather than just their name. --}}
          {{#if attachedActor.system.background.role}}
            <div class="e20-nowrap">{{localize 'E20.ActorRole'}}: {{attachedActor.system.background.role}}</div>
          {{/if}}
          {{#if attachedActor.system.gainingTheContact}}
            <div class="e20-nowrap" data-tooltip="{{attachedActor.system.gainingTheContact}}">{{localize 'E20.ContactGainedVia'}}: {{attachedActor.system.gainingTheContact}}</div>
          {{/if}}
        {{/if}}

        {{#if (eq attachedActor.type "zord")}}
          <div>{{localize 'E20.ActorSize'}}: {{lookup @root.config.actorSizes attachedActor.system.size}}</div>
          {{#if (eq @root.document.type "megaform")}}
            {{!-- Ranger only exists on a Zord (zord.mjs's own system.ranger field) - a Transformers
                 Combiner's own playerCharacter components have no such field, so this only shows
                 for a Power Rangers Megazord's linked Zords. --}}
            <div>
              <span>{{ localize 'E20.ZordRanger' }}: {{attachedActor.system.ranger}}</span>
            </div>
          {{/if}}
        {{/if}}
        {{#if (eq @root.document.type "megaform")}}
          <div>
          <div>{{ localize 'E20.ItemTypeMegaformTraitPlural' }}:</div>
            <ul>
              {{#each attachedActor.items as |item|}}
              {{#if (eq item.type 'megaformTrait')}}
              <li>{{item.name}}</li>
              {{/if}}
              {{/each}}
            </ul>
          </div>
          {{!-- Zord Features (Martial Zord, Zero-G, Auxiliary Zord, ...) stay owned by the
               participant that holds them (like Megaform Traits above) - shown here read-only so
               it's visible at a glance which ones are currently contributing to this merged
               form, since there's no add/edit control for them on the Megaform's own sheet. --}}
          <div>
          <div>{{ localize 'E20.ItemTypeFeaturePlural' }}:</div>
            <ul>
              {{#each attachedActor.items as |item|}}
              {{#if (eq item.type 'feature')}}
              <li>{{item.name}}</li>
              {{/if}}
              {{/each}}
            </ul>
          </div>
        {{/if}}
        {{#inArray '["vehicle", "zord"]' @root.document.type}}
          {{#each @root.system.actors as |current key2|}}
            {{#if (eq key key2)}}
              <label for="current.vehicleRole" class="resource-label">{{localize 'E20.VehicleRole'}}</label>
              <select class="vehicle-role" name="current.vehicleRole" key={{@key}}>
                {{selectOptions @root.config.vehicleRoles selected=current.vehicleRole}}
              </select>
            {{/if}}
          {{/each}}
        {{/inArray}}
      </div>
      {{/each}}
    {{else}}
      <div class="e20-align-center">
        {{localize 'E20.ActorDrop'}}
      </div>
    {{/if}}
  </div>
</div>
