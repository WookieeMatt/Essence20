<div class="stats-container flexrow e20-flex-group-center e20-border-accent e20-min-width-fit">
  <div class="flexcol e20-flex-group-center">
    <div class="flexrow e20-gap-5 e20-nowrap">
      <a class="rest e20-flex-grow-0" data-tooltip="{{localize "E20.RestButtonTitle"}}"><i class="fas fa-face-sleeping"></i></a>
      <label>{{localize 'E20.ActorHealth'}}</label>
      <a class="e20-flex-grow-0" data-action="editHealth" data-tooltip="{{localize 'E20.StatEditorHealthTooltip'}}"><i class="fas fa-gear"></i></a>
    </div>
    <div class="flexrow e20-gap-5 e20-align-center">
      <input class="two-digit-input no-lock" type="number" name="system.health.value" value="{{system.health.value}}" min="0" step="1" />
      <span>/</span>
      {{#if @root.system.movementIsReadOnly}}
        <input class="two-digit-input no-unlock" type="number" name="system.health.max" value="{{system.health.max}}" title="{{system.health.string}}" readonly/>
      {{else}}
        <input class="two-digit-input no-lock" type="number" name="system.health.max" value="{{system.health.max}}" min="0" step="1"/>
      {{/if}}
    </div>
  </div>
</div>
