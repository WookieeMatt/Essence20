<div class="sliced-border flexrow flex-group-center" style="min-width:fit-content; border-color: {{system.color}};">
  <label class="sliced-border__label">{{localize 'E20.ActorStun'}}</label>
  <div class="flexrow" style="align-items: center;">
    <input class="two-digit-input no-lock" type="number" name="system.stun.value" value="{{system.stun.value}}" min="0" step="1" />
    <span>/</span>
    <input class="two-digit-input no-unlock" type="number" name="system.stun.max" value="{{system.health.value}}" readonly/>
  </div>
</div>
