<div class="stats-container flexrow flex-group-center e20-border-accent min-width-fit">
  <div class="flexcol flex-group-center">
    <label>{{localize 'E20.ActorStun'}}</label>
    <div class="flexrow align-center">
      <input class="two-digit-input no-lock" type="number" name="system.stun.value" value="{{system.stun.value}}" min="0" step="1" />
      <span>/</span>
      <input class="two-digit-input no-unlock" type="number" name="system.stun.max" value="{{system.health.value}}" readonly/>
    </div>
  </div>
</div>
