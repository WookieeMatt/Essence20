{{!-- Skill header --}}
<div class="flexrow skill-header e20-skill-header" data-e20-color="{{@root.system.color}}">
  <a
    class="rollable skill-name" data-action="rollable" data-roll-type="skill" data-skill="{{skill}}" data-essence="{{essence}}"
    data-shift-up ="{{fields.shiftUp}}" data-shift-down ="{{fields.shiftDown}}"
    data-shift="{{fields.shift}}" data-is-specialized="{{fields.isSpecialized}}" data-can-crit-d2="{{fields.canCritD2}}" data-tooltip="{{localize 'E20.SkillRollTitle'}}"
  >
    {{lookup @root.config.skills skill}}
  </a>
  <select class="skill-shift-select" name="system.skills.{{skill}}.shift">
    {{selectOptions @root.config.skillShifts selected=fields.shift}}
  </select>
  <a class="add-specialization" data-action="itemCreate" data-type="specialization" data-skill="{{skill}}" data-shift="{{fields.shift}}" data-tooltip="{{ localize 'E20.AddSpecialization' }}">
    <i class="fas fa-plus" data-type="specialization" data-skill="{{skill}}" data-shift="{{fields.shift}}" ></i>
  </a>
  {{!-- Casting Cost (MLP CRB p.132): casting a Spell downshifts the caster's Spellcasting
       Skill, and that downshift lingers until recovered - shown only once there's actually a
       downshift to track/clear. Spellcasting now only ever renders here via the Spells tab
       (spells.hbs), not the narrow sidebar it used to share space in, so there's room for this
       inline instead of needing its own row. --}}
  {{#if (eq skill 'spellcasting')}}
    {{#if fields.shiftDown}}
    <span class="chip spellcasting-downshift-chip" data-tooltip="{{localize 'E20.SpellcastingDownshiftTooltip'}}">
      {{localize 'E20.SpellcastingDownshift'}}: -{{fields.shiftDown}}
    </span>
    <a class="spellcasting-downshift-action" data-action="recoverSpellcastingDownshift" data-tooltip="{{localize 'E20.SpellcastingDownshiftRecoverTooltip'}}">
      <i class="fas fa-arrow-up"></i>
    </a>
    <a class="spellcasting-downshift-action" data-action="sufferForSpellcastingDownshift" data-tooltip="{{localize 'E20.SpellcastingDownshiftRecoverHealthTooltip'}}">
      <i class="fas fa-heart-crack"></i>
    </a>
    {{/if}}
  {{/if}}
</div>

<div class="skill-body">
  {{#inArray '["companion", "npc", "vehicle", "zord"]' @root.actor.type}}
  <div class="flexrow skill-specialized-row">
    <span class="specialized-label">{{localize 'E20.RollIsSpecialized'}}:</span>
    <input class="specialized-checkbox" type="checkbox" name="system.skills.{{skill}}.isSpecialized" {{checked fields.isSpecialized}} data-dtype="Boolean"/>
  </div>
  {{/inArray}}

  {{!-- Specializations list --}}
  <ol class="items-list"></ol>
    {{#each (lookup @root.specializations skill) as |specialization i|}}
    <li class="item specializations-list" data-item-id="{{specialization._id}}">
      <div class="flexrow specializations-item">
        <span class="item-button-container">
          {{#inArray '["companion", "npc", "vehicle", "zord"]' @root.actor.type}}
          {{!-- NPCs can have unspecialized specializations, but PCs are always specialized --}}
          <a
            class="rollable" data-action="rollable" data-roll-type="skill" data-skill="{{../skill}}" data-essence="{{../essence}}"
            data-shift-up ="{{../fields.shiftUp}}" data-shift-down ="{{../fields.shiftDown}}"
            data-shift="{{specialization.system.shift}}" data-specialization-name="{{specialization.name}}"
            data-is-specialized="{{specialization.system.isSpecialized}}" data-tooltip="{{localize 'E20.SkillRollTitle'}}"
          >
          <i class="fas fa-dice-d20" data-roll-type="skill" data-skill="{{../skill}}" data-essence="{{../essence}}"
            data-shift-up ="{{../fields.shiftUp}}" data-shift-down ="{{../fields.shiftDown}}"
            data-shift="{{specialization.system.shift}}" data-specialization-name="{{specialization.name}}"
            data-is-specialized="{{specialization.system.isSpecialized}}" ></i>
          {{else}}
          <a
            class="rollable" data-action="rollable" data-roll-type="skill" data-skill="{{../skill}}" data-essence="{{../essence}}"
            data-shift-up ="{{../fields.shiftDown}}" data-shift-down ="{{../fields.shiftDown}}"
            data-shift="{{../fields.shift}}" data-specialization-name="{{specialization.name}}" data-is-specialized="true" data-tooltip="{{ localize 'E20.SkillRollTitle'}}"
          >
          <i class="fas fa-dice-d20" data-roll-type="skill" data-skill="{{../skill}}" data-essence="{{../essence}}"
            data-shift-up ="{{../fields.shiftDown}}" data-shift-down ="{{../fields.shiftDown}}"
            data-shift="{{../fields.shift}}" data-specialization-name="{{specialization.name}}" data-is-specialized="true" ></i>
          {{/inArray}}
          </a>
        </span>
        <input class="inline-edit" data-field="name" type="text" name="{{../skill}}.{{specialization.name}}" value="{{specialization.name}}" />
        {{#inArray '["companion", "npc", "vehicle", "zord"]' @root.actor.type}}
        <select class="inline-edit flex-grow-0" data-field="system.shift" name="system.shift">
          {{selectOptions @root.config.skillShifts selected=specialization.system.shift}}
        </select>
        <span class="specialized-label flex-grow-0">{{localize 'E20.RollIsSpecialized'}}:</span>
        <input class="inline-edit specialized-checkbox" type="checkbox" data-field="system.isSpecialized" name="specialization.system.isSpecialized" {{checked specialization.system.isSpecialized}} data-dtype="Boolean"/>
        {{/inArray}}
        <span class="item-button-container">
          <a class="item-control" data-action="itemDelete" data-tooltip="{{localize 'E20.ItemControlDelete'}}"><i class="fas fa-trash" data-uuid="{{specialization.uuid}}"></i></a>
        </span>
      </div>
    </li>
    {{/each}}
  </ol>
</div>
