{{!-- Skill header --}}
<div class="flexrow skill-header e20-skill-header" data-e20-color="{{@root.system.color}}">
  <a
    class="rollable skill-name" data-action="rollable" data-roll-type="skill" data-skill="{{skill}}" data-essence="{{essence}}"
    data-shift-up ="{{fields.shiftUp}}" data-shift-down ="{{fields.shiftDown}}"
    data-shift="{{fields.shift}}" data-is-specialized="{{fields.isSpecialized}}" data-can-crit-d2="{{fields.canCritD2}}" data-tooltip="{{localize 'E20.SkillRollTitle'}}"
  >
    {{lookup @root.config.skills skill}}
  </a>
  {{!-- readOnly: shift-editing for PCs moved into the Skill Picker app (module/apps/skill-picker.mjs,
       opened via the gear icon next to each Essence's tally) so it lives in one place instead of
       scattered across this tab, the sidebar, and the Spells tab - this just displays the
       current value there instead of an editable dropdown. --}}
  {{#if readOnly}}
  <span class="skill-shift-select skill-shift-display">{{fields.shift}}</span>
  {{else}}
  <select class="skill-shift-select" name="system.skills.{{skill}}.shift">
    {{selectOptions @root.config.skillChoicesShifts selected=fields.shift}}
  </select>
  {{/if}}
  {{!-- Casting Cost (MLP CRB p.132): casting a Spell downshifts the caster's Spellcasting
       Skill, and that downshift lingers until recovered - shown only once there's actually a
       downshift to track/clear. Spellcasting now only ever renders here via the Spells tab
       (spells.hbs), not the narrow sidebar it used to share space in, so there's room for this
       inline instead of needing its own row. --}}
  {{#if (eq skill 'spellcasting')}}
    {{#if fields.shiftDown}}
    <span class="chip spellcasting-downshift-chip" data-tooltip="{{localize 'E20.SpellcastingDownshiftTooltip'}}">
      {{localize 'E20.SpellcastingDownshift'}}: -{{fields.shiftDown}}
    </span>
    <a class="spellcasting-downshift-action" data-action="recoverSpellcastingDownshift" data-tooltip="{{localize 'E20.SpellcastingDownshiftRecoverTooltip'}}">
      <i class="fas fa-arrow-up"></i>
    </a>
    <a class="spellcasting-downshift-action" data-action="sufferForSpellcastingDownshift" data-tooltip="{{localize 'E20.SpellcastingDownshiftRecoverHealthTooltip'}}">
      <i class="fas fa-heart-crack"></i>
    </a>
    {{/if}}
  {{/if}}
</div>

<div class="skill-body">
  {{#inArray '["companion", "npc", "megaform", "vehicle", "zord"]' @root.document.type}}
  <div class="flexrow skill-specialized-row">
    <span class="specialized-label">{{localize 'E20.RollIsSpecialized'}}:</span>
    <input class="specialized-checkbox" type="checkbox" name="system.skills.{{skill}}.isSpecialized" {{checked fields.isSpecialized}} data-dtype="Boolean"/>
  </div>
  {{/inArray}}

  {{!-- Specializations list - a name-only rollable "tab" under the parent skill, matching the
       skill-name link right above (no icon, no separate roll button). Adding and removing both
       live in the Skill Picker (module/apps/skill-picker.mjs) now, not here - see
       essence20-specialization-redesign; this is roll-only display. Keyed by an opaque id (see
       helpers/utils.mjs#createId), not by name, since a Perk automation targeting one specific
       specialization needs to survive a rename. --}}
  <ol class="items-list">
    {{#each fields.specializations as |specialization key|}}
    <li class="item specializations-list" data-skill="{{../skill}}" data-specialization-key="{{key}}">
      <div class="flexrow specializations-item">
        {{#inArray '["companion", "npc", "megaform", "vehicle", "zord"]' @root.document.type}}
        {{!-- NPCs can have unspecialized specializations, but PCs are always specialized --}}
        <a
          class="rollable specialization-name" data-action="rollable" data-roll-type="skill" data-skill="{{../skill}}" data-essence="{{../essence}}"
          data-shift-up ="{{../fields.shiftUp}}" data-shift-down ="{{../fields.shiftDown}}"
          data-shift="{{specialization.shift}}" data-specialization-name="{{specialization.name}}"
          data-specialization-key="{{key}}" data-is-specialized="{{specialization.isSpecialized}}"
        >{{specialization.name}}</a>
        <select class="inline-edit flex-grow-0" data-field="shift">
          {{selectOptions @root.config.skillChoicesShifts selected=specialization.shift}}
        </select>
        <span class="specialized-label flex-grow-0">{{localize 'E20.RollIsSpecialized'}}:</span>
        <input class="inline-edit specialized-checkbox" type="checkbox" data-field="isSpecialized" {{checked specialization.isSpecialized}} data-dtype="Boolean"/>
        {{else}}
        <a
          class="rollable specialization-name" data-action="rollable" data-roll-type="skill" data-skill="{{../skill}}" data-essence="{{../essence}}"
          data-shift-up ="{{../fields.shiftDown}}" data-shift-down ="{{../fields.shiftDown}}"
          data-shift="{{../fields.shift}}" data-specialization-name="{{specialization.name}}"
          data-specialization-key="{{key}}" data-is-specialized="true"
        >{{specialization.name}}</a>
        {{/inArray}}
      </div>
    </li>
    {{/each}}
  </ol>
</div>
