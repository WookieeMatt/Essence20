<div class="resource initiative e20-border-accent">
  <span>{{localize 'E20.ActorInitiative'}}</span>
  <div class="initiative-dropdown flex-group-center">
    <div class="item-image">
      <a class="rollable" data-action="rollable" data-roll-type="initiative" data-tooltip="{{localize 'E20.SkillRollTitle'}}"><i class="fas fa-dice-d20" data-roll-type="initiative"></i></a>
    </div>
    <select name="system.initiative.skill">
      {{selectOptions @root.initiativeSkills selected=system.initiative.skill valueAttr="key" labelAttr="label"}}
    </select>
  </div>
</div>
