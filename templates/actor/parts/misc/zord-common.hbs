<div class="flexrow stats-row">
  {{!-- Strength/Speed --}}
  <div class="stats-container e20-border-accent min-width-fit align-center">
    <div class="flexrow flex-group-center">
      <span class="essence-label">{{config.essences.strength}}</span>
      <input class="two-digit-input{{#if (eq @root.document.type 'megaform')}} no-unlock{{/if}}" type="number" name="system.essences.strength.value" value="{{system.essences.strength.value}}" min="0" step="1" />
    </div>
    <div class="flexrow flex-group-center">
      <span class="essence-label">{{config.essences.speed}}</span>
      <input class="two-digit-input{{#if (eq @root.document.type 'megaform')}} no-unlock{{/if}}" type="number" name="system.essences.speed.value" value="{{system.essences.speed.value}}" min="0" step="1" />
    </div>
  </div>
</div>

<div class="npc-row">
  {{!-- Skills --}}
  <div class="npc-skills">
    {{> "systems/essence20/templates/actor/parts/misc/accordion-skills.hbs"}}
  </div>

  <div class="npc-items">
    {{!-- Weapons --}}
    {{> "systems/essence20/templates/actor/parts/items/weapon/container.hbs"}}
    {{!-- Features --}}
    {{> "systems/essence20/templates/actor/parts/items/feature/container.hbs"}}
    {{!-- Megaform Traits --}}
    {{#if (eq @root.document.type 'zord')}}
    {{> "systems/essence20/templates/actor/parts/items/megaformTrait/container.hbs"}}
    {{/if}}
  </div>
</div>
