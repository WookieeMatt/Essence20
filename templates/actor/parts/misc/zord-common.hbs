<div class="npc-row">
  <div class="npc-essence-scores">
    {{!-- Zord/Megaform Essence Scores - same shared partial/box style as NPC and Companion,
         stretched full-width by .npc-essence-scores (sass/actors/_npc.scss). Previously only
         Strength/Speed were shown inline here; now covers all 4 like the other actor types. --}}
    {{> "systems/essence20/templates/actor/parts/misc/npc-essence-scores.hbs"}}
  </div>
</div>

<div class="npc-row">
  {{!-- Skills --}}
  <div class="npc-skills">
    {{> "systems/essence20/templates/actor/parts/misc/npc-skill-list.hbs"}}
  </div>

  <div class="npc-items">
    {{!-- Weapons --}}
    {{> "systems/essence20/templates/actor/parts/items/weapon/container.hbs"}}
    {{!-- Features --}}
    {{> "systems/essence20/templates/actor/parts/items/feature/container.hbs"}}
    {{!-- Megaform Traits --}}
    {{#if (eq @root.document.type 'zord')}}
    {{> "systems/essence20/templates/actor/parts/items/megaformTrait/container.hbs"}}
    {{/if}}
  </div>
</div>
