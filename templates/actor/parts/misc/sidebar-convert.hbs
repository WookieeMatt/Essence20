{{!-- A Vehicle's or Zord's Transform button (sheets/machine-alt-modes.mjs - a world setting), in the sidebar's Special
     panel like a Transformer's (sidebar-transform-morph.hbs), with the Alt Mode it's in. --}}
{{#if @root.canConvert}}
  <a class="essence20-sidebar-action-button" data-action="transform">
    <i class="fas fa-steering-wheel"></i>
    {{localize 'E20.Transform'}}
    {{#if system.isTransformed}}
      <span class="e20-state-badge --altmode">{{#if @root.altModeName}}{{@root.altModeName}}{{else}}{{localize "E20.StatusAltMode"}}{{/if}}</span>
    {{/if}}
  </a>
{{/if}}
