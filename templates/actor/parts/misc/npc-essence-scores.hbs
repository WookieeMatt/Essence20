<div class="stats-container flexrow e20-flex-group-center e20-border-accent">
  {{#each system.essences as |essence|}}
  <div class="flexcol">
    <label>{{lookup @root.config.essences @key}}</label>
    <div class="flexrow e20-flex-group-center">
      {{#if (and (isdefined essence.base) (isdefined essence.max))}}
      {{!-- NPC / Companion (mechanics/characters/creature-essences.mjs): current / score, like a Player Character. The
           score is always worked out (the base, with effects and rules on top), so it is read-only; the base is edited
           in the Base field underneath. --}}
      <input class="two-digit-input" type="number" name="system.essences.{{@key}}.value" value="{{essence.value}}" min="0" step="1" />
        /
      <input class="two-digit-input no-unlock e20-essence-score" type="number" value="{{essence.max}}" readonly tabindex="-1"
        data-tooltip="{{localize 'E20.CreatureEssenceBase' essence=(localize (lookup @root.config.essences @key)) value=essence.max}}" />
      {{else if (and (isdefined essence.base) (ne @root.document.type 'megaform'))}}
      {{!-- Zord / Vehicle (mechanics/vehicles/machine-essences.mjs): current / the worked-out score, read-only; the base
           underneath. The current amount is the score less the Essence damage taken (mechanics/combat/essence-current.mjs);
           typing it sets that damage. An Essence left blank uses the driver's (Smarts and Social by default) and shows a
           dash. --}}
      {{#if (and (isdefined essence.value) (ne essence.value null))}}
      <input class="two-digit-input" type="number" name="essenceCurrent.{{@key}}" value="{{essence.current}}" min="0" max="{{essence.value}}" step="1" />
        /
      {{/if}}
      <input class="two-digit-input no-unlock e20-essence-score" type="text" value="{{#if (and (isdefined essence.value) (ne essence.value null))}}{{essence.value}}{{else}}&ndash;{{/if}}" readonly tabindex="-1"
        data-tooltip="{{#if (and (isdefined essence.value) (ne essence.value null))}}{{localize 'E20.MachineEssenceBase' essence=(localize (lookup @root.config.essences @key)) value=essence.value}}{{else}}{{localize 'E20.MachineEssenceUsesDriver'}}{{/if}}" />
      {{else if (eq @root.document.type 'megaform')}}
      {{!-- Megaform: current / the score worked out from its Zords, never typed (no-unlock keeps it read-only whatever
           the sheet's lock). --}}
      <input class="two-digit-input" type="number" name="essenceCurrent.{{@key}}" value="{{essence.current}}" min="0" max="{{essence.value}}" step="1" />
        /
      <input class="two-digit-input no-unlock e20-essence-score" type="number" value="{{essence.value}}" readonly tabindex="-1" />
      {{else}}
      <input class="two-digit-input" type="number" name="system.essences.{{@key}}.value" value="{{essence.value}}" min="0" step="1" />
      {{/if}}
      {{!-- A {max, value} pair with no base (an old shape) keeps its own max input. --}}
      {{#if (and (isdefined essence.max) (not (isdefined essence.base)))}}
        /
      <input class="two-digit-input" type="number" name="system.essences.{{@key}}.max" value="{{essence.max}}" min="0" step="1" />
      {{/if}}
    </div>
    {{!-- The typed base, always editable here. --}}
    {{#if (and (isdefined essence.base) (ne @root.document.type 'megaform'))}}
    <div class="flexrow e20-flex-group-center e20-essence-base">
      <label>{{localize 'E20.EssenceBaseLabel'}}</label>
      <input class="two-digit-input" type="number" name="system.essences.{{@key}}.base" value="{{essence.base}}" min="0" step="1" />
    </div>
    {{/if}}
  </div>
  {{/each}}
  {{!-- Zord / Vehicle / Megaform Essence damage is temporary: one button takes it all off. --}}
  {{#if (or (eq @root.document.type 'zord') (eq @root.document.type 'vehicle') (eq @root.document.type 'megaform'))}}
  {{#if @root.essenceDamaged}}
  <a class="e20-essence-repair" data-action="repairEssences" data-tooltip="{{localize 'E20.MachineEssenceRepairTip'}}"><i class="fas fa-screwdriver-wrench"></i> {{localize 'E20.MachineEssenceRepair'}}</a>
  {{/if}}
  {{/if}}
</div>
