<section class="tab combiners {{tabs.combiners.cssClass}}" data-tab="combiners" data-group="primary">
  {{!-- A Transformers Combiner's Hardpoints (Enigma of Combination p.44): two External, one Integrated per member. --}}
  {{#inArray system.subtype 'megaformCombiner'}}
  {{#if system.hardpoints}}
  <div class="chip-section loadout-summary">
    <span class="chip loadout-chip{{#if system.hardpoints.integrated.over}} is-over{{/if}}" data-tooltip="{{localize 'E20.CombinerHardpointsHint'}}">
      {{localize 'E20.HardpointIntegrated'}}: {{system.hardpoints.integrated.used}} / {{system.hardpoints.integrated.max}}
    </span>
    <span class="chip loadout-chip{{#if system.hardpoints.external.over}} is-over{{/if}}" data-tooltip="{{localize 'E20.CombinerHardpointsHint'}}">
      {{localize 'E20.HardpointExternal'}}: {{system.hardpoints.external.used}} / {{system.hardpoints.external.max}}
    </span>
  </div>
  {{/if}}
  {{/inArray}}
  {{!-- No combined Health: a Megaform has none of its own (each participant's is its own - the sidebar lists them). --}}
  {{#if (or system.isDefeated system.hasEnhancedAttack system.hasAssaultWeapon system.hasEnhancedInitiative system.hasTitanHardpoint)}}
  <div class="stats-container flexrow e20-flex-group-center e20-border-accent megaform-summary">
    {{#if system.isDefeated}}
    <div class="flexcol e20-flex-group-center">
      <label>{{localize 'E20.MegaformDefeated'}}</label>
      <span><i class="fas fa-skull"></i> {{localize 'E20.MegaformDefeatedDesc'}}</span>
    </div>
    {{/if}}
    {{#if system.hasEnhancedAttack}}
    <div class="flexcol e20-flex-group-center">
      <label>{{localize 'E20.MegaformHasEnhancedAttack'}}</label>
      <span>{{localize 'E20.MegaformHasEnhancedAttackDesc'}}</span>
    </div>
    {{/if}}
    {{#if system.hasAssaultWeapon}}
    <div class="flexcol e20-flex-group-center">
      <label>{{localize 'E20.MegaformHasAssaultWeapon'}}</label>
      <span>{{localize 'E20.MegaformHasAssaultWeaponDesc'}}</span>
    </div>
    {{/if}}
    {{#if system.hasEnhancedInitiative}}
    <div class="flexcol e20-flex-group-center">
      <label>{{localize 'E20.MegaformHasEnhancedInitiative'}}</label>
      <span>{{localize 'E20.MegaformHasEnhancedInitiativeDesc'}}</span>
    </div>
    {{/if}}
    {{#if system.hasTitanHardpoint}}
    <div class="flexcol e20-flex-group-center">
      <label>{{localize 'E20.MegaformHasTitanHardpoint'}}</label>
      <span>{{localize 'E20.MegaformHasTitanHardpointDesc'}}</span>
    </div>
    {{/if}}
  </div>
  {{/if}}

  {{!-- Forming rules, GM only (mechanics/vehicles/megaform-participants.mjs): what they are now, and the button that
       opens the Forming Rules window (apps/megaform-forming-config.mjs) to change them. --}}
  {{#if megaformJoin}}
  <fieldset class="megaform-join-rules">
    <legend>{{localize 'E20.MegaformJoinRules'}}</legend>
    <div class="form-group">
      <label>{{localize 'E20.MegaformSubtype'}}</label>
      <span>{{megaformJoin.summary.rules}}</span>
    </div>
    <div class="form-group">
      <label>{{localize 'E20.MegaformJoinTypes'}}</label>
      <span>{{#if megaformJoin.summary.custom}}{{megaformJoin.joins}}{{else}}{{localize 'E20.MegaformFormingBookRules'}}{{/if}}</span>
    </div>
    {{#if megaformJoin.needed}}
    <div class="form-group">
      <label>{{localize 'E20.MegaformRequiredMembers'}}</label>
      <span>{{megaformJoin.needed}}</span>
    </div>
    {{/if}}
    <button type="button" data-action="megaformForming"><i class="fa-solid fa-puzzle-piece"></i> {{localize 'E20.MegaformFormingOpen'}}</button>
  </fieldset>
  {{/if}}

  {{> "systems/essence20/templates/actor/parts/misc/system-actors.hbs" actors=@root.actors}}
</section>
