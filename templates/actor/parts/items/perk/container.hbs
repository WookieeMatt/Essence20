{{#if (or alwaysShow perks)}}
  {{#> "systems/essence20/templates/actor/parts/misc/collapsible-item-container.hbs" items=perks title=title dataType="perk"}}
    {{#*inline "expand-details" item}}
      {{> "systems/essence20/templates/actor/parts/items/perk/details.hbs"}}
    {{/inline}}

    {{#*inline "plus-button" item}}
      <a data-action="itemCreate" data-type={{dataType}} data-perk-type={{perkType}} data-tooltip="{{ localize 'E20.ItemControlAdd' }}">
        <i class="fas fa-plus" data-type={{dataType}} data-perk-type={{perkType}} ></i>
      </a>
    {{/inline}}

    {{#*inline "item-label" item}}
      <div class="flexrow align-center gap-5 leveled-item-label">
        {{#if item.system.grantedLevel}}
          <span class="leveled-item-badge">{{item.system.grantedLevel}}</span>
        {{/if}}
        <img class="leveled-item-icon" src="{{item.img}}" alt="{{item.name}}" />
        <span class="leveled-item-name">{{item.name}}</span>
      </div>
    {{/inline}}
  {{/"systems/essence20/templates/actor/parts/misc/collapsible-item-container.hbs"}}
{{/if}}
