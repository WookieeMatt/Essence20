<label for="system.focus" class="resource-label">{{localize 'E20.ActorFocus'}}</label>

{{#if @root.focuses}}
  {{#each @root.focuses as |item|}}
    <li class="item no-list-style" data-item-id="{{item._id}}" data-parent-id="{{../parentId}}">
      <div class="flexrow align-center gap-2">
        <input type="text" name="system.role" value="{{item.name}}" />
        <div class="item-controls flex-grow-0">
          <a class="item-control item-delete" data-tooltip="{{localize 'E20.DeleteItem'}}">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </div>
    </li>
  {{/each}}
{{else}}
  <div class="flexrow">
    <input class="no-unlock" type="text" value="{{localize 'E20.FocusDrop'}}" readonly />
  </div>
{{/if}}
