<label for="system.focus" class="sliced-border__label">{{localize 'E20.ActorFocus'}}</label>

{{#if @root.focuses}}
  {{#each @root.focuses as |item|}}
    <li class="item e20-no-list-style" data-item-id="{{item._id}}" data-parent-id="{{../parentId}}">
      <div class="flexrow e20-align-center e20-gap-2">
        <span class="header-item-name">{{item.name}}</span>
        <div class="item-controls e20-flex-grow-0">
          <a class="item-control item-delete" data-action="itemDelete" data-tooltip="{{localize 'E20.DeleteItem'}}">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </div>
      {{!-- The skills the Focus's Essence increase must go into (e.g. GI Joe CRB p.81) - book data, shown so the
            player can place that rank in the Skill Picker. --}}
      {{#if item.system.skills.length}}
      <div class="chip-section">
        <span class="chip" name="chip.focus.skills">{{localize 'E20.FocusIncreaseSkills'}}: {{#each item.system.skills as |skill|}}{{lookup @root.config.originSkills skill}}{{#unless @last}}, {{/unless}}{{/each}}</span>
      </div>
      {{/if}}
    </li>
  {{/each}}
{{else}}
  <div class="flexrow">
    <span class="header-item-name header-item-placeholder">{{localize 'E20.FocusDrop'}}</span>
    <div class="item-controls e20-flex-grow-0">
      {{> "systems/essence20/templates/actor/parts/misc/browse-compendium.hbs" type='focus'}}
    </div>
  </div>
{{/if}}
