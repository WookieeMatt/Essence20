{{#>"systems/essence20/templates/actor/parts/misc/collapsible-item-container.hbs" items=@root.weapons title='E20.ItemTypeWeaponPlural' dataType='weapon'}}
  {{#*inline "container-header-extra"}}
    {{!-- Carry limits are a player character's bookkeeping: a GM running an NPC has no use for a
         hands count, so the strip shows on character sheets only (Essence20Actor still derives it
         for NPCs, for anything else that reads it). Not on My Little Pony at all. --}}
    {{#if (and (ne @root.role.system.version 'myLittlePony') (eq @root.document.type 'playerCharacter'))}}
      {{> "systems/essence20/templates/actor/parts/misc/loadout-summary.hbs"}}
    {{/if}}
  {{/inline}}

  {{#*inline "expand-details" item}}
    {{> "systems/essence20/templates/actor/parts/items/weapon/details.hbs"}}
  {{/inline}}

  {{#*inline "item-label" item}}
    <div class="flexrow e20-align-center e20-gap-5 leveled-item-label">
      {{#if item.system.grantedLevel}}
        <span class="leveled-item-badge">{{item.system.grantedLevel}}</span>
      {{/if}}
      <img class="leveled-item-icon" src="{{item.img}}" alt="{{item.name}}" />
      <span class="leveled-item-name">{{item.name}}</span>
    </div>
  {{/inline}}

  {{!-- Transformer Hardpoint controls get their own full-width line under the weapon, so the
       type/Reinforced/visibility controls stay on one row instead of wrapping in the label. --}}
  {{#*inline "item-subrow" item}}
    {{#if @root.system.canTransform}}
      {{>"systems/essence20/templates/actor/parts/misc/hardpoint-selector.hbs"}}
    {{/if}}
  {{/inline}}

  {{#*inline "extra-controls" item}}
    {{!-- Obfuscated (Quartermaster's Guide to Gear, p.33) - a reminder only; the DIF 25
         Alertness Skill Test belongs to whoever is trying to notice the weapon. --}}
    {{#inArray item.system.traits "obfuscated"}}
      <span data-tooltip="{{localize 'E20.WeaponTraitObfuscatedHint'}}"><i class="fas fa-eye-slash"></i></span>
    {{/inArray}}
    {{!-- Mounted (GI Joe CRB, Weapon Effects and Traits, p.148) - see items/attacks/mounted-weapons.mjs's own
         doc comment. A Standard action to deploy, a Free action to fold back down; the weapon
         can't be fired (item.mjs#roll) until this has been done. --}}
    {{#inArray item.system.traits "mounted"}}
      <a data-action="mountedSetupToggle" data-item-id="{{item._id}}" data-tooltip="{{#if item.flags.essence20.mountedSetUp}}{{localize 'E20.MountedPickUp'}}{{else}}{{localize 'E20.MountedSetUp'}}{{/if}}">
        {{#if item.flags.essence20.mountedSetUp}}
          <i class="fas fa-person-carry-box" data-item-id="{{item._id}}"></i>
        {{else}}
          <i class="fas fa-screwdriver-wrench" data-item-id="{{item._id}}"></i>
        {{/if}}
      </a>
    {{/inArray}}
    {{!-- Mythically Modular (Through the Shattered Grid p.116) - switch to this form as a Free
         action; see items/attacks/mythically-modular.mjs. --}}
    {{#inArray item.system.itemAndUpgradeTraits "mythicallyModular"}}
      {{#unless item.system.equipped}}
      <a data-action="mythicSwitchForm" data-item-id="{{item._id}}" data-tooltip="{{localize 'E20.MythicallyModularSwitch'}}">
        <i class="fas fa-arrows-rotate" data-item-id="{{item._id}}"></i>
      </a>
      {{/unless}}
    {{/inArray}}
    <a data-action="itemCreate" data-type="weaponEffect" data-parent-id="{{item._id}}" data-tooltip="{{ localize 'E20.ItemControlAdd' }} {{localize 'E20.WeaponEffect'}}">
      <i class="fas fa-burst" data-type="weaponEffect" data-parent-id="{{item._id}}" ></i>
    </a>
    <a data-action="itemCreate" data-type="upgrade" data-parent-id="{{item._id}}" data-tooltip="{{ localize 'E20.ItemControlAdd' }} {{localize 'E20.Upgrade'}}">
      <i class="fas fa-up" data-type="upgrade" data-parent-id="{{item._id}}" ></i>
    </a>
  {{/inline}}

  {{#*inline "subcontainers" parentItem}}
    {{!-- Weapon Effects --}}
    {{#>"systems/essence20/templates/actor/parts/misc/collapsible-item-subcontainer.hbs" items=parentItem.system.items title="E20.ItemTypeWeaponEffectPlural" dataType="weaponEffect" parentItem=parentItem}}

      {{#*inline "roll-button"}}
        <a class="rollable" data-action="rollable" data-roll-type="weaponEffect" data-tooltip="{{localize 'E20.WeaponEffectRollTitle'}}"><i class="fas fa-dice-d20" data-roll-type="weaponEffect"></i></a>
      {{/inline}}

      {{#*inline "item-label" item}}
        {{> "systems/essence20/templates/actor/parts/items/weapon/weapon-effects.hbs"}}
      {{/inline}}

      {{#*inline "expand-details" item parentItem}}
        {{> "systems/essence20/templates/actor/parts/items/weaponEffect/details.hbs"}}
      {{/inline}}
    {{/"systems/essence20/templates/actor/parts/misc/collapsible-item-subcontainer.hbs"}}

    {{!-- Upgrades --}}
    {{#>"systems/essence20/templates/actor/parts/misc/collapsible-item-subcontainer.hbs" items=parentItem.system.items title="E20.ItemTypeUpgradePlural" dataType="upgrade" parentItem=parentItem}}
      {{#*inline "item-label" item}}
        {{item.name}}
      {{/inline}}

      {{#*inline "expand-details" item parentItem}}
        {{> "systems/essence20/templates/actor/parts/items/upgrade/details.hbs"}}
      {{/inline}}
    {{/"systems/essence20/templates/actor/parts/misc/collapsible-item-subcontainer.hbs"}}
  {{/inline}}
{{/"systems/essence20/templates/actor/parts/misc/collapsible-item-container.hbs"}}
