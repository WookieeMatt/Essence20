<div class="flexrow e20-gap-2 weapon-effect-row">
  <div class="weapon-effect-name">
    {{item.name}}
  </div>
  <select class="inline-edit weapon-effect-skill" data-field="system.classification.skill" data-parent-field="system.items.{{@key}}.classification.skill" name="item.classification.skill">
    {{selectOptions @root.weaponEffectSkills selected=item.classification.skill valueAttr="key" labelAttr="label" localize=true}}
  </select>

  <div class="flexrow e20-gap-2 weapon-effect-chips">
    <div class="e20-align-center chip weapon-effect-chip" data-tooltip="{{item.numTargets}} {{localize "E20.WeaponTargets"}}">
      {{item.numTargets}} <i class="fas fa-bullseye"></i>
    </div>
    {{#if item.range.reachMultiplier}}
      <div class="e20-align-center chip weapon-effect-chip" data-tooltip="{{localize "E20.WeaponRangeReach"}} {{item.totalReach}}ft">
        {{item.totalReach}}ft
      </div>
    {{else}}
      <div class="e20-align-center chip weapon-effect-chip" data-tooltip="{{localize "E20.WeaponRange"}} {{#if item.range.value}}{{item.range.value}}{{else}}0{{/if}}ft{{#if item.range.long}}/{{item.range.long}}ft{{/if}}{{#if item.range.min}}/minimum {{item.range.min}}ft{{/if}}">
        {{#if item.range.value}}{{item.range.value}}{{else}}0{{/if}}ft
      </div>
    {{/if}}
    <div class="e20-align-center chip weapon-effect-chip" data-tooltip="{{item.shiftDown}} {{localize "E20.ShiftDown"}}">
      {{item.shiftDown}} <i class="fas fa-arrow-down"></i>
    </div>
    <div class="e20-align-center chip weapon-effect-chip" data-tooltip="{{item.numHands}} {{localize "E20.WeaponHands"}}">
      {{item.numHands}} <i class="fas fa-hand"></i>
    </div>
    {{#each (weaponEffectDamages item) as |damage|}}
    <div class="e20-align-center chip weapon-effect-chip" data-tooltip="{{damage.value}} {{localize (lookup @root.config.damageTypes damage.type)}} {{localize "E20.Damage"}}">
      {{damage.value}} <i class="fas {{damage.icon}}"></i>
    </div>
    {{/each}}
  </div>
</div>
