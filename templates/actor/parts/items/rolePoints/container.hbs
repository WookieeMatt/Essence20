  {{#if @root.rolePointsList.length}}
    {{#each @root.rolePointsList as |rolePoints|}}
      <div class="item flexrow align-center role-points-item" data-item-id="{{rolePoints._id}}">
        {{!-- Label - left-click toggles Activation (if this Role Points item supports it);
             right-click opens a menu to Post to Chat or Spend a Point (see
             base-actor-sheet.mjs#_activateRolePointsListeners). --}}
        <label
          class="role-points-name{{#if rolePoints.system.isActive}} active{{/if}}"
          {{#if rolePoints.system.isActivatable}}
            data-is-activatable="true"
            data-tooltip="{{localize 'E20.RolePointsToggleActivation'}}"
          {{/if}}
          {{#if (ne rolePoints.system.resource.max null)}}
            data-can-spend="true"
          {{/if}}
        >{{rolePoints.name}}</label>

        {{!-- Bonus --}}
        <div class="flex-grow-0 nowrap">
          {{#if (ne rolePoints.system.bonus.type 'none')}}
            {{#if (ne rolePoints.system.bonus.type 'other')}}+{{/if}}{{rolePoints.system.bonus.value}}
          {{/if}}

          {{#if (eq rolePoints.system.bonus.type 'attackUpshift')}}
            <i class="fas fa-arrow-up"></i>
          {{else if (eq rolePoints.system.bonus.type 'damageBonus')}}
             <i class="fas fa-sword"></i>
          {{else if (eq rolePoints.system.bonus.type 'enemyDownshift')}}
            <i class="fas fa-arrow-down"></i>
          {{else if (eq rolePoints.system.bonus.type 'healthBonus')}}
            <i class="fas fa-heart"></i>
          {{else if (eq rolePoints.system.bonus.type 'defenseBonus')}}
            <i class="fas fa-shield"></i>
            {{rolePoints.system.bonus.defenseBonus.string}}
          {{/if}}
        </div>
        {{!-- Resource --}}
        {{#if @root.system.useUnlimitedResource}}
          <div class="flex-grow-0">{{localize 'E20.RolePointsResourceUnlimited'}}</div>
        {{else if (ne rolePoints.system.resource.max null)}}
          <input class="inline-edit two-digit-input no-lock flex-grow-0" data-field="system.resource.value" type="number"
            name="system.resource.value" value="{{rolePoints.system.resource.value}}" min="0"
            step="1" />
          /
          <input class="two-digit-input no-unlock flex-grow-0" data-field="rolePoints.system.resource.max" type="number"
            name="rolePoints.system.resource.max" value="{{rolePoints.system.resource.max}}" min="0"
            step="1" readonly />
        {{/if}}
      </div>
    {{/each}}
  {{else if @root.role.system.skillDie.isUsed}}
    {{#with @root.system.skills.roleSkillDie as |roleSkillDie|}}
      <div class="item flexrow align-center" data-item-id="{{@root.role._id}}">
        <div class="item-image flex-grow-0">
          <a class="rollable" data-action="rollable" data-roll-type="skill" data-skill="roleSkillDie" data-role-skill-name="{{@root.role.system.skillDie.name}}"
            data-is-specialized="{{roleSkillDie.isSpecialized}}"><i class="fas fa-dice-d20"></i></a>
        </div>
        <div>{{@root.role.system.skillDie.name}}: {{roleSkillDie.shift}}{{#if roleSkillDie.isSpecialized}}*{{/if}}</div>
      </div>
    {{/with}}
  {{/if}}

  {{#if (not (or @root.rolePointsList.length @root.role.system.skillDie.isUsed))}}
    <div class="flexrow flex-group-center">{{localize 'E20.RolePointsNone'}}</div>
  {{/if}}
