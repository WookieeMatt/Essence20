<label for="system.role" class="sliced-border__label">{{localize 'E20.ActorRole'}}</label>

{{#if @root.roles}}
  {{#each @root.roles as |item|}}
    <li class="item no-list-style" data-item-id="{{item._id}}" data-parent-id="{{../parentId}}">
      <div class="flexrow align-center gap-2">
        <span class="header-item-name">{{item.name}}</span>
        <span class="chip"{{#if item.system.isEffectiveLevel}} data-tooltip="{{localize 'E20.RoleEffectiveLevel'}}"{{/if}}>{{localize 'E20.ActorLevel'}} {{item.system.displayLevel}}</span>
        <div class="item-controls flex-grow-0">
          <a class="item-control item-delete" data-action="itemDelete" data-tooltip="{{localize 'E20.DeleteItem'}}">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </div>
    </li>
  {{/each}}
{{else}}
  <div class="flexrow">
    <span class="header-item-name header-item-placeholder">{{localize 'E20.RoleDrop'}}</span>
  </div>
{{/if}}
