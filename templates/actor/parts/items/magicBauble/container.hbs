{{#>"systems/essence20/templates/actor/parts/misc/collapsible-item-container.hbs" items=@root.magicBaubles title="E20.ItemTypeMagicBaublePlural" dataType="magicBauble"}}
  {{#*inline "roll-button" item}}
    <a class="rollable" data-action="rollable" data-roll-type="magicBauble"  data-tooltip="{{localize 'E20.MagicBaubleTitle'}}"><i class="fas fa-dice-d20" data-roll-type="magicBauble"></i></a>
  {{/inline}}

  {{#*inline "expand-details" item}}
    {{> "systems/essence20/templates/actor/parts/items/magicBauble/details.hbs"}}
  {{/inline}}

  {{#*inline "item-label" item}}
    <div class="flexrow align-center gap-5 leveled-item-label">
      {{#if item.system.grantedLevel}}
        <span class="leveled-item-badge">{{item.system.grantedLevel}}</span>
      {{/if}}
      <img class="leveled-item-icon" src="{{item.img}}" alt="{{item.name}}" />
      <span class="leveled-item-name">{{item.name}}</span>
    </div>
  {{/inline}}
{{/"systems/essence20/templates/actor/parts/misc/collapsible-item-container.hbs"}}
