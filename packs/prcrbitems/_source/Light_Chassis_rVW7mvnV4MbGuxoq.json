  "system": {
    "rules": [
      {"type":"RollModifier","label":"Light Chassis","scope":"megaform","upshift":1,"stacks":false,"when":["roll:initiative","megaform:is:zord"]},
      {"type":"Trigger","label":"Light Chassis","event":"added","removeOnStop":true,"steps":[{"do":"notify","text":"E20.ZordFeatureNoMovement","level":"warn","stop":true,"when":["not:self:data:system.movement.aerial.base>0","not:self:data:system.movement.burrow.base>0","not:self:data:system.movement.climb.base>0","not:self:data:system.movement.ground.base>0","not:self:data:system.movement.swim.base>0"]},{"do":"choose","prompt":"Which movement type goes up 10 feet?","options":[{"label":"Aerial","when":["self:data:system.movement.aerial.base>0"],"steps":[{"do":"setEffects","effects":[{"changeKey":"system.movement.aerial.bonus","on":true}]},{"do":"notify","text":"E20.ZordFeatureMovementApplied","data":{"type":"E20.MovementTypeAerial"}}]},{"label":"Burrow","when":["self:data:system.movement.burrow.base>0"],"steps":[{"do":"addEffect","name":"Light Chassis (Burrow)","img":"icons/svg/aura.svg","changes":[{"key":"system.movement.burrow.bonus","value":10}]},{"do":"notify","text":"E20.ZordFeatureMovementApplied","data":{"type":"E20.MovementTypeBurrow"}}]},{"label":"Climb","when":["self:data:system.movement.climb.base>0"],"steps":[{"do":"setEffects","effects":[{"changeKey":"system.movement.climb.bonus","on":true}]},{"do":"notify","text":"E20.ZordFeatureMovementApplied","data":{"type":"E20.MovementTypeClimb"}}]},{"label":"Ground","when":["self:data:system.movement.ground.base>0"],"steps":[{"do":"setEffects","effects":[{"changeKey":"system.movement.ground.bonus","on":true}]},{"do":"notify","text":"E20.ZordFeatureMovementApplied","data":{"type":"E20.MovementTypeGround"}}]},{"label":"Swim","when":["self:data:system.movement.swim.base>0"],"steps":[{"do":"setEffects","effects":[{"changeKey":"system.movement.swim.bonus","on":true}]},{"do":"notify","text":"E20.ZordFeatureMovementApplied","data":{"type":"E20.MovementTypeSwim"}}]}]}]}
    ],
    "automation": {
      "status": "full",
      "notes": "<p>Active Effect: +1 Speed for the Zord. When added you pick a movement type, which goes up 10 feet. Automatic: ↑1 on Initiative for any Megaform it joins.</p>"
    },
