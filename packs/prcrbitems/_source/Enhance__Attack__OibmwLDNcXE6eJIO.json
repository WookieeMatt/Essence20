    "rules": [
      {"type":"Trigger","label":"Enhance (Attack)","event":"added","removeOnStop":true,"steps":[{"do":"notify","text":"E20.ZordFeatureNoAttacks","level":"warn","stop":true,"when":["not:self:hasItemWhere:item:type:weaponEffect"]},{"do":"pick","key":"attack","from":"ownedItem","itemType":"weaponEffect","prompt":"Which attack is enhanced?"},{"do":"pick","key":"option","from":"list","prompt":"Which enhancement?","options":[["accurate","E20.ZordFeatureEnhanceAccurate"],["damage","E20.ZordFeatureEnhanceDamage"],["reach","E20.ZordFeatureEnhanceReach"],["range","E20.ZordFeatureEnhanceRange"],["multiWeapon","E20.ZordFeatureEnhanceMultiWeapon"],["damageType","E20.ZordFeatureEnhanceDamageType"],["ignoreArmor","E20.ZordFeatureEnhanceIgnoreArmor"],["reduceSpeed","E20.ZordFeatureEnhanceReduceSpeed"]]},{"do":"setVar","key":"option","value":"{choice.option}"},{"do":"adjustItem","item":"choice:attack","onParent":true,"addTraits":["accurate"],"required":true,"message":"E20.ZordFeatureEnhanceNoParentWeapon","when":["var:option=accurate"]},{"do":"adjustItem","item":"choice:attack","add":{"system.damageValue":1},"when":["var:option=damage"]},{"do":"adjustItem","item":"choice:attack","multiply":{"system.range.reachMultiplier":2},"defaults":{"system.range.reachMultiplier":1},"when":["var:option=reach"]},{"do":"adjustItem","item":"choice:attack","add":{"system.range.value":30,"system.range.long":60},"when":["var:option=range"]},{"do":"adjustItem","item":"choice:attack","add":{"system.numTargets":1},"atLeast":{"system.numTargets":2},"defaults":{"system.numTargets":1},"when":["var:option=multiWeapon"]},{"do":"pick","key":"damageType","from":"damageType","prompt":"Which damage type?","when":["var:option=damageType"]},{"do":"adjustItem","item":"choice:attack","set":{"system.damageType":"{choice.damageType}"},"when":["var:option=damageType"]},{"do":"notify","text":"E20.ZordFeatureEnhanceManual","when":[{"any":["var:option=ignoreArmor","var:option=reduceSpeed"]}]},{"do":"notify","text":"E20.ZordFeatureEnhanceApplied","data":{"option":"E20.ZordFeatureEnhanceAccurate","attack":"{var.adjustedItemName}"},"when":["var:option=accurate"]},{"do":"notify","text":"E20.ZordFeatureEnhanceApplied","data":{"option":"E20.ZordFeatureEnhanceDamage","attack":"{var.adjustedItemName}"},"when":["var:option=damage"]},{"do":"notify","text":"E20.ZordFeatureEnhanceApplied","data":{"option":"E20.ZordFeatureEnhanceReach","attack":"{var.adjustedItemName}"},"when":["var:option=reach"]},{"do":"notify","text":"E20.ZordFeatureEnhanceApplied","data":{"option":"E20.ZordFeatureEnhanceRange","attack":"{var.adjustedItemName}"},"when":["var:option=range"]},{"do":"notify","text":"E20.ZordFeatureEnhanceApplied","data":{"option":"E20.ZordFeatureEnhanceMultiWeapon","attack":"{var.adjustedItemName}"},"when":["var:option=multiWeapon"]},{"do":"notify","text":"E20.ZordFeatureEnhanceApplied","data":{"option":"E20.ZordFeatureEnhanceDamageType","attack":"{var.adjustedItemName}"},"when":["var:option=damageType"]}]}
