    "rules": [
      {"type":"Trigger","label":"Movement Booster","event":"added","removeOnStop":true,"steps":[{"do":"choose","prompt":"Which movement type? (+30 ft, or a new one at 45 ft)","options":[{"label":"Aerial","steps":[{"do":"setEffects","effects":[{"changeKey":"system.movement.aerial.bonus","on":true}],"when":["self:data:system.movement.aerial.base>0"]},{"do":"addEffect","name":"Movement Booster (Aerial)","img":"icons/svg/aura.svg","changes":[{"key":"system.movement.aerial.bonus","value":45}],"when":["not:self:data:system.movement.aerial.base>0"]},{"do":"notify","text":"E20.ZordFeatureMovementApplied","data":{"type":"E20.MovementTypeAerial"}}]},{"label":"Burrow","steps":[{"do":"addEffect","name":"Movement Booster (Burrow)","img":"icons/svg/aura.svg","changes":[{"key":"system.movement.burrow.bonus","value":30}],"when":["self:data:system.movement.burrow.base>0"]},{"do":"addEffect","name":"Movement Booster (Burrow)","img":"icons/svg/aura.svg","changes":[{"key":"system.movement.burrow.bonus","value":45}],"when":["not:self:data:system.movement.burrow.base>0"]},{"do":"notify","text":"E20.ZordFeatureMovementApplied","data":{"type":"E20.MovementTypeBurrow"}}]},{"label":"Climb","steps":[{"do":"setEffects","effects":[{"changeKey":"system.movement.climb.bonus","on":true}],"when":["self:data:system.movement.climb.base>0"]},{"do":"addEffect","name":"Movement Booster (Climb)","img":"icons/svg/aura.svg","changes":[{"key":"system.movement.climb.bonus","value":45}],"when":["not:self:data:system.movement.climb.base>0"]},{"do":"notify","text":"E20.ZordFeatureMovementApplied","data":{"type":"E20.MovementTypeClimb"}}]},{"label":"Ground","steps":[{"do":"setEffects","effects":[{"changeKey":"system.movement.ground.bonus","on":true}],"when":["self:data:system.movement.ground.base>0"]},{"do":"addEffect","name":"Movement Booster (Ground)","img":"icons/svg/aura.svg","changes":[{"key":"system.movement.ground.bonus","value":45}],"when":["not:self:data:system.movement.ground.base>0"]},{"do":"notify","text":"E20.ZordFeatureMovementApplied","data":{"type":"E20.MovementTypeGround"}}]},{"label":"Swim","steps":[{"do":"setEffects","effects":[{"changeKey":"system.movement.swim.bonus","on":true}],"when":["self:data:system.movement.swim.base>0"]},{"do":"addEffect","name":"Movement Booster (Swim)","img":"icons/svg/aura.svg","changes":[{"key":"system.movement.swim.bonus","value":45}],"when":["not:self:data:system.movement.swim.base>0"]},{"do":"notify","text":"E20.ZordFeatureMovementApplied","data":{"type":"E20.MovementTypeSwim"}}]}]}]}
    ],
    "automation": {
      "status": "full",
      "notes": "<p>When added to a Zord you pick a movement type: +30 feet to one it has, or a new one at 45 feet.</p>"
