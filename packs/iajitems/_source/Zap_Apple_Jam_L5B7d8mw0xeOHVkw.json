ps>0","not:rule:data:flags.essence20.zapCups>=0"]},{"any":["rule:data:flags.essence20.zapCups>=0","rule:data:system.quantity>0"]}],"steps":[{"do":"updateItem","when":["rule:data:flags.essence20.zapCups>=0"],"add":{"flags.essence20.zapCups":-1}},{"do":"updateItem","when":["not:rule:data:flags.essence20.zapCups>=0"],"set":{"flags.essence20.zapCups":"3 * @item.system.quantity - 1"}},{"do":"chat","text":"{name} barters a cup of Zap Apple jam: the Wealth Test passes automatically ({@item.flags.essence20.zapCups} cups left)."}]},{"label":"Eat a pastry (heal 1 Essence, Edge for a turn)","when":["rule:data:flags.essence20.zapPastries>0"],"steps":[{"do":"updateItem","add":{"flags.essence20.zapPastries":-1}},{"do":"healEssence","amount":1},{"do":"setToggle","when":["combat:exists"],"key":"pastry","value":true,"until":"turnOrUntilCombat"},{"do":"bank","when":["not:combat:exists"],"replace":true,"edge":true,"label":"Zap Apple jam pastry"},{"do":"chat","text":"{name} eats a Zap Apple jam pastry: Edge on Skill Tests for a turn ({@item.flags.essence20.zapPastries} pastries left)."}]}]}]},
