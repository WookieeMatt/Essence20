      {"type":"Defense","label":"Meat Shield","defense":"toughness","mode":"addAfter","stack":"meatShield","amount":"2 * min(1, max(0, @level - 6)) + min(1, max(0, @level - 11)) + min(1, max(0, @level - 19))"},
