      {"type":"Use","label":"Switch Meat Shield on","when":["not:self:toggle:on"],"steps":[{"do":"pick","key":"resist","from":"list","options":[["acid","E20.DamageAcid"],["blunt","E20.DamageBlunt"],["cold","E20.DamageCold"],["electric","E20.DamageElectric"],["emp","E20.DamageEmp"],["fire","E20.DamageFire"],["laser","E20.DamageLaser"],["poison","E20.DamagePoison"],["psychic","E20.DamagePsychic"],["sharp","E20.DamageSharp"],["sonic","E20.DamageSonic"],["stun","E20.DamageStun"],["void","E20.DamageVoid"]],"prompt":"Meat Shield: Resistance to which damage type?","when":["self:level>=13","not:self:level>=18"],"beforeCost":true},{"do":"pick","key":"immune","from":"list","options":[["acid","E20.DamageAcid"],["blunt","E20.DamageBlunt"],["cold","E20.DamageCold"],["electric","E20.DamageElectric"],["emp","E20.DamageEmp"],["fire","E20.DamageFire"],["laser","E20.DamageLaser"],["poison","E20.DamagePoison"],["psychic","E20.DamagePsychic"],["sharp","E20.DamageSharp"],["sonic","E20.DamageSonic"],["stun","E20.DamageStun"],["void","E20.DamageVoid"]],"prompt":"Meat Shield: immunity to which damage type?","when":["self:level>=18"],"beforeCost":true},{"do":"setToggle","key":"on","value":true,"until":"nextTurn"}],"cost":{"action":"free"}},
