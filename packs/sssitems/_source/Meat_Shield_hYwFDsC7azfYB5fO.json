      {"type":"Defense","label":"Meat Shield","defense":"evasion","mode":"addAfter","stack":"meatShield","amount":"(2 + min(8, max(0, floor((@level - 1) / 2)))) * (1 - min(1, max(0, @level - 19))) + 15 * min(1, max(0, @level - 19))","when":["self:toggle:on"]},
