      {"type":"Use","label":"Fortify","when":["calc:@rolePoints >= 1"],"limit":{"per":"scene"},"steps":[{"do":"choose","prompt":"E20.ExpandedMysticismFortifyPickDefenseLabel","options":[{"label":"E20.DefenseToughness","steps":[{"do":"setVar","key":"defense","value":"toughness"}]},{"label":"E20.DefenseEvasion","steps":[{"do":"setVar","key":"defense","value":"evasion"}]}]},{"do":"spend","resource":{"rolePoints":true},"amount":1},{"do":"updateActor","to":"self","set":{"flags.essence20.expandedMysticismFortifyType":"{var.defense}"}},{"do":"mark","key":"expandedMysticismFortified","to":"self","until":"scene"},{"do":"chat","text":"{name} fortifies their {var.defense} for the rest of the scene."}]},
      {"type":"Use","label":"Heal","when":["calc:@rolePoints >= 1"],"limit":{"per":"scene"},"steps":[{"do":"require","check":["self:data:system.health.value<$system.health.max"],"message":"{lang.ExpandedMysticismHealNoMissingHealth}"},{"do":"askNumber","var":"amount","prompt":"E20.ExpandedMysticismHealPickAmountLabel","min":1,"max":"min(@rolePoints, @actor.system.health.max - @actor.system.health.value)"},{"do":"spend","resource":{"rolePoints":true},"amount":"@var.amount"},{"do":"updateActor","to":"self","add":{"system.health.value":"@var.amount"}},{"do":"chat","text":"{name} spends {var.amount} Mystical Points to regain {var.amount} Health."}]},
      {"type":"Use","label":"Quicken","when":["calc:@rolePoints >= 1"],"limit":{"per":"scene"},"steps":[{"do":"choose","prompt":"E20.ExpandedMysticismQuickenPickMovementLabel","options":[{"label":"E20.MovementTypeAerial","steps":[{"do":"setVar","key":"movement","value":"aerial"}]},{"label":"E20.MovementTypeBurrow","steps":[{"do":"setVar","key":"movement","value":"burrow"}]},{"label":"E20.MovementTypeClimb","steps":[{"do":"setVar","key":"movement","value":"climb"}]},{"label":"E20.MovementTypeGround","steps":[{"do":"setVar","key":"movement","value":"ground"}]},{"label":"E20.MovementTypeSwim","steps":[{"do":"setVar","key":"movement","value":"swim"}]}]},{"do":"spend","resource":{"rolePoints":true},"amount":1},{"do":"updateActor","to":"self","set":{"flags.essence20.expandedMysticismQuickenType":"{var.movement}"}},{"do":"chat","text":"{name} doubles their {var.movement} Movement until the end of their turn."}]},
      {"type":"Defense","label":"Fortify (Expanded Mysticism: +1 Toughness)","defense":"toughness","amount":1,"when":["defense:toughness","self:marked:expandedMysticismFortified","self:data:flags.essence20.expandedMysticismFortifyType=toughness"]},
