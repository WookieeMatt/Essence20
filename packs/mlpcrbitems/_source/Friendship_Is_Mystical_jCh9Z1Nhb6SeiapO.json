      {"type":"Use","label":"Spend Mystical Points on a targeted friend","steps":[{"do":"target","max":1},{"do":"warn","text":"E20.RulesExtItems2.NotYourself","stop":true,"when":["target:self"]},{"do":"setVar","key":"points","value":"@rolePoints"},{"do":"choose","prompt":"Which benefit for {target}?","options":[{"label":"Magically Fit In (1 Mystical Point: 1 rank in a Skill this scene)","steps":[{"do":"pick","key":"fimSkill","from":"skill","prompt":"Which Skill?"},{"do":"warn","text":"E20.Mlp2NoMystical","stop":true,"when":["var:points<1"]},{"do":"spend","resource":{"rolePoints":true},"amount":1},{"do":"mark","key":"fimFitIn","to":"target","text":"{choice.fimSkill}","until":"scene"},{"do":"chat","text":"{name} spends a Mystical Point so {target} magically fits in."}]},{"label":"Fortify (Free action, 1 Mystical Point)","steps":[{"do":"choose","prompt":"Which Defense?","options":[{"label":"Toughness","steps":[{"do":"setVar","key":"defense","value":"toughness"}]},{"label":"Evasion","steps":[{"do":"setVar","key":"defense","value":"evasion"}]}]},{"do":"warn","text":"E20.Mlp2NoMystical","stop":true,"when":["var:points<1"]},{"do":"spendAction","action":"free"},{"do":"spend","resource":{"rolePoints":true},"amount":1},{"do":"updateActor","to":"target","set":{"flags.essence20.expandedMysticismFortifyType":"{var.defense}"}},{"do":"chat","text":"{name} spends a Mystical Point to fortify {target}."}]},{"label":"Heal (Standard action, Mystical Points for that much Health)","steps":[{"do":"setVar","key":"amount","value":"max(0, min(@target.system.health.max - @target.system.health.value, @rolePoints))"},{"do":"require","check":["var:amount>=1"]},{"do":"spendAction","action":"standard"},{"do":"spend","resource":{"rolePoints":true},"amount":"@var.amount"},{"do":"heal","to":"target","amount":"@var.amount"},{"do":"chat","text":"{name} spends {var.amount} Mystical Point(s) to heal {target}."}]}]}]},
      {"type":"RollModifier","scope":"marked","mark":"fimFitIn","label":"Magically Fit In (Friendship Is Mystical)","upshift":1,"when":["self:markText:fimFitIn=$skill"]}
    ],
