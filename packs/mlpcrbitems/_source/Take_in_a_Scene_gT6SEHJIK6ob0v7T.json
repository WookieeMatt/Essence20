{
  "name": "Take in a Scene",
  "type": "perk",
  "img": "systems/essence20/assets/icons/items/perk.svg",
  "system": {
    "rules": [
      {"type":"Trigger","event":"initiativeRolling","label":"Take in a Scene","when":["self:status:surprised"],"steps":[{"do":"choose","auto":true,"options":[{"label":"Against the lowest hostile Infiltration","when":["recent:hostile:infiltration"],"steps":[{"do":"roll","skill":"alertness","dif":"@recent.lowestHostile.infiltration + 1","onSuccess":[{"do":"removeCondition","condition":"surprised"},{"do":"chat","text":"{name} takes in the scene and is not Surprised."}],"onFail":[{"do":"mark","key":"misplacedConfidence","to":"self","until":"combat","count":"max(1, @combat.round) + 1","when":["self:holdsActive:Compendium.essence20.mlp_crb.Item.LcKUw5rQd19ovk4I","combat:exists"]},{"do":"chat","text":"{name} fails to take in the scene (Misplaced Confidence): Surprised for two rounds.","when":["self:holdsActive:Compendium.essence20.mlp_crb.Item.LcKUw5rQd19ovk4I","combat:exists"]},{"do":"chat","text":"{name} fails to take in the scene and stays Surprised.","when":[{"any":["not:self:holdsActive:Compendium.essence20.mlp_crb.Item.LcKUw5rQd19ovk4I","not:combat:exists"]}]}]}]},{"label":"The GM rules on it","when":["not:recent:hostile:infiltration"],"steps":[{"do":"roll","skill":"alertness","open":true,"sheetShifts":false},{"do":"button","who":"gm","label":"Rule on Take in a Scene","intro":"Take in a Scene: did {name}'s Alertness roll notice whoever is trying to Surprise them?","steps":[{"do":"choose","options":[{"label":"Noticed - not Surprised","steps":[{"do":"removeCondition","condition":"surprised"},{"do":"chat","text":"{name} takes in the scene and is not Surprised."}]},{"label":"Missed - stays Surprised","steps":[{"do":"mark","key":"misplacedConfidence","to":"self","until":"combat","count":"max(1, @combat.round) + 1","when":["self:holdsActive:Compendium.essence20.mlp_crb.Item.LcKUw5rQd19ovk4I","combat:exists"]},{"do":"chat","text":"{name} fails to take in the scene (Misplaced Confidence): Surprised for two rounds.","when":["self:holdsActive:Compendium.essence20.mlp_crb.Item.LcKUw5rQd19ovk4I","combat:exists"]},{"do":"chat","text":"{name} fails to take in the scene and stays Surprised.","when":[{"any":["not:self:holdsActive:Compendium.essence20.mlp_crb.Item.LcKUw5rQd19ovk4I","not:combat:exists"]}]}]}]}]}]}]}]}
    ],
    "automation": {
      "status": "full",
      "notes": "<p>Automatic: when you roll Initiative while Surprised, you also roll Alertness against the sneakiest hostile creature's Infiltration; on a success you're no longer Surprised.</p>"
