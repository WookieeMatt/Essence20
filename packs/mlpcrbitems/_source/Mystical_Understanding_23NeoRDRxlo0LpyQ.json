  "system": {
    "rules": [
      {"type":"SpellCost","label":"Spellcosting: Mystical Points to spend","op":"spend","spend":{"resource":{"rolePoints":true}},"note":"Spellcosting: {amount} Mystical Point(s) spent to lower the Cost."},
      {"type":"Use","label":"Refocus, Essential Research or Magically Fit In","steps":[{"do":"setVar","key":"points","value":"@rolePoints"},{"do":"setVar","key":"researched","value":"@flagList.essentialResearch"},{"do":"choose","prompt":"Which benefit of Mystical Understanding?","options":[{"label":"Refocus (Standard action, 2 Mystical Points)","steps":[{"do":"warn","text":"E20.Mlp2NoMystical","stop":true,"when":["var:points<2"]},{"do":"spendAction","action":"standard"},{"do":"spend","resource":{"rolePoints":true},"amount":2},{"do":"updateActor","set":{"system.skills.spellcasting.shiftDown":0}},{"do":"chat","text":"{name} refocuses: Spellcasting is back to its Total Rank."}]},{"label":"Essential Research (1 Mystical Point: +1 to an Essence until you rest)","steps":[{"do":"warn","text":"E20.Mlp2ResearchDone","stop":true,"when":["var:researched>=3"]},{"do":"pick","key":"researchEssence","from":"essence","prompt":"Which Essence?"},{"do":"warn","text":"E20.Mlp2NoMystical","stop":true,"when":["var:points<1"]},{"do":"spend","resource":{"rolePoints":true},"amount":1},{"do":"updateActor","add":{"system.essences.{choice.researchEssence}.max":1,"system.essences.{choice.researchEssence}.value":1}},{"do":"flagList","flag":"essentialResearch","add":"{choice.researchEssence}"},{"do":"chat","text":"{name}'s Essential Research raises that Essence by 1 until their next rest."}]},{"label":"Magically Fit In (Mystical Points for that many ranks in a Skill, this scene)","steps":[{"do":"warn","text":"E20.Mlp2NoMystical","stop":true,"when":["var:points<1"]},{"do":"askNumber","var":"fitIn","min":1,"max":"@rolePoints","prompt":"How many Mystical Points (one rank each)?"},{"do":"pick","key":"fitInSkill","from":"skill","prompt":"Which Skill?"},{"do":"spend","resource":{"rolePoints":true},"amount":"@var.fitIn"},{"do":"mark","to":"self","key":"magicallyFitIn","count":"@var.fitIn","until":"scene"},{"do":"chat","text":"{name} magically fits in: +{var.fitIn} ranks in that Skill this scene."}]}]}]},
      {"type":"RollModifier","label":"Magically Fit In","upshift":"@mark.magicallyFitIn","when":["self:marked:magicallyFitIn","skill:{choice.fitInSkill}","not:roll:initiative"]},
      {"type":"Trigger","event":"rest","label":"Essential Research ends","steps":[{"do":"setVar","key":"lost","value":"@flagList.essentialResearch.strength"},{"do":"updateActor","when":["var:lost>=1"],"add":{"system.essences.strength.max":"-@var.lost"},"set":{"system.essences.strength.value":"@actor.system.essences.strength.value"},"max":"@actor.system.essences.strength.max - @var.lost"},{"do":"setVar","key":"lost","value":"@flagList.essentialResearch.speed"},{"do":"updateActor","when":["var:lost>=1"],"add":{"system.essences.speed.max":"-@var.lost"},"set":{"system.essences.speed.value":"@actor.system.essences.speed.value"},"max":"@actor.system.essences.speed.max - @var.lost"},{"do":"setVar","key":"lost","value":"@flagList.essentialResearch.smarts"},{"do":"updateActor","when":["var:lost>=1"],"add":{"system.essences.smarts.max":"-@var.lost"},"set":{"system.essences.smarts.value":"@actor.system.essences.smarts.value"},"max":"@actor.system.essences.smarts.max - @var.lost"},{"do":"setVar","key":"lost","value":"@flagList.essentialResearch.social"},{"do":"updateActor","when":["var:lost>=1"],"add":{"system.essences.social.max":"-@var.lost"},"set":{"system.essences.social.value":"@actor.system.essences.social.value"},"max":"@actor.system.essences.social.max - @var.lost"},{"do":"flagList","flag":"essentialResearch","clear":true}]},
      {"type":"DialogSwitch","label":"Spend 1 Mystical Point (Spellcialize: Specialized)","when":["not:roll:untrained","not:roll:skillSpecialized","not:roll:initiative"],"specialize":true,"cost":{"resource":{"rolePoints":true},"amount":1}}
    ],
    "automation": {
      "status": "full",
      "notes": "<p>Use button: Refocus (Standard action, 2 Mystical Points, clears your Spellcasting downshift), Essential Research (1 point, +1 to an Essence until your next Rest, three a day), or Magically Fit In (spend points for that many ranks in a Skill you pick, until the GM starts a new scene). Spellcosting appears when you cast; Spellcialize is a Roll Options Dialog switch.</p>"
