      {"type":"Use","label":"Treat a healthy ally (Temporary Health)","steps":[{"do":"pickAlly","filter":["target:data:system.health.value>=$system.health.max","target:data:system.health.bonus<=0","not:target:markedByMe:preventativeMeasures"]},{"do":"warn","text":"E20.PreventativeMeasuresNoEligibleTarget","stop":true,"when":[{"any":["target:data:system.health.value<$system.health.max","target:data:system.health.bonus>0","target:markedByMe:preventativeMeasures"]}]},{"do":"choose","prompt":"Which Skill?","options":[{"label":"Science","steps":[{"do":"setVar","key":"skill","value":"science"}]},{"label":"Technology","steps":[{"do":"setVar","key":"skill","value":"technology"}]}]},{"do":"askNumber","var":"amount","min":1,"max":6,"prompt":"Health to attempt to restore"},{"do":"mark","key":"preventativeMeasures","to":"target","perSetter":true,"until":"calendarDay"},{"do":"roll","skill":"{var.skill}","dif":"5 + 5 * @var.amount","onSuccess":[{"do":"heal","to":"target","amount":"@var.amount","temporary":true}]}]}
