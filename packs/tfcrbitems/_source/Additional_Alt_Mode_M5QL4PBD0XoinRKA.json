      {"type":"Trigger","event":"added","label":"Pick your additional Alt Mode","steps":[{"do":"pickChassis","mode":"additional","flag":"additionalAltMode","choose":true},{"do":"grant","uuid":"{var.chassis}","flags":{"additionalAltMode":true},"systemFrom":"chassisSystem"},{"do":"updateActor","set":{"system.canTransform":true}},{"do":"chat","text":"{name} gains a second Alt Mode: {var.chassisName}."}]},
