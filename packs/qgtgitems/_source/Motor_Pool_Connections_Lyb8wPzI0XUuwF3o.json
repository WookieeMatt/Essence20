      {"type":"Use","label":"Requisition a vehicle upgrade (3 budget points per vehicle per mission)","steps":[{"do":"pick","key":"vehicle","from":"ownedVehicles","auto":true,"prompt":"Which vehicle is the upgrade for?"},{"do":"windowCount","flag":"motorPool-{choice.vehicle}","window":"mission","var":"used"},{"do":"setVar","key":"left","value":"3 - @var.used"},{"do":"warn","text":"E20.RulesExtItems2.MotorPoolSpent","stop":true,"when":["var:left<1"]},{"do":"pickEntry","from":{"type":"upgrade","fields":["system.type","system.availability"],"tags":["item:data:system.type=vehicle","item:upgradeCostAtMost:@var.left"]}},{"do":"choose","prompt":"Roll the upgrade's Requisition with which Skill?","options":[{"label":"Technology","steps":[{"do":"setVar","key":"skill","value":"technology"}]},{"label":"Driving","steps":[{"do":"setVar","key":"skill","value":"driving"}]}]},{"do":"setVar","key":"cost","value":1,"when":["var:pickedAvailability=automatic"]},{"do":"setVar","key":"cost","value":1,"when":["var:pickedAvailability=standard"]},{"do":"setVar","key":"cost","value":2,"when":["var:pickedAvailability=limited"]},{"do":"setVar","key":"cost","value":5,"when":["var:pickedAvailability=restricted"]},{"do":"setVar","key":"cost","value":7,"when":["var:pickedAvailability=prototype"]},{"do":"setVar","key":"cost","value":7,"when":["var:pickedAvailability=unique"]},{"do":"setVar","key":"cost","value":10,"when":["var:pickedAvailability=theoretical"]},{"do":"markWindow","flag":"motorPool-{choice.vehicle}","window":"mission","count":"@var.cost"},{"do":"giveCopy","to":"picked:vehicle","uuid":"{var.picked}","flags":{"motorPool":true},"when":["var:pickedDif<=0"]},{"do":"roll","skill":"{var.skill}","dif":"@var.pickedDif","when":["var:pickedDif>=1"],"onSuccess":[{"do":"giveCopy","to":"picked:vehicle","uuid":"{var.picked}","flags":{"motorPool":true}}],"onFail":[{"do":"chat","text":"Motor Pool Connections: the request for {var.pickedName} was denied."}]}]}
