e: Accurate."}]},{"label":"↑2 to the pilot's Group Skill Tests","when":["not:self:marked:pr1OdGroupTaken"],"steps":[{"do":"spendFrom","to":"picked:payer","resource":{"path":"system.powers.personal.value"},"amount":1},{"do":"mark","key":"pr1OdGroupTaken","to":"self","until":"turnOrUntilCombat"},{"do":"mark","key":"pr1OdCount","to":"self","count":1,"add":true,"until":"turnOrUntilCombat"},{"do":"mark","key":"pr1OdGroup","to":"driver","until":"nextTurn","untilOf":"recipient"},{"do":"chat","text":"{var.paidBy} feeds 1 Personal Power into {name}'s Overdrive: ↑2 to Group Skill Tests."}]}]}]},
