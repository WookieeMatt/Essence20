    "rules": [
      {"type":"Trigger","event":"added","label":"Enhance Strike: enhance a Unique Strike","steps":[{"do":"pick","key":"strike","from":"ownedItem","itemType":"weaponEffect","filter":["item:data:flags.essence20.isUniqueStrike"],"auto":true,"prompt":"Which Unique Strike?"},{"do":"choose","prompt":"Choose an enhancement","options":[{"label":"Increase base damage by +1","steps":[{"do":"updateItem","item":"choice:strike","add":{"system.damageValue":1}}]},{"label":"Change damage type to an Element","steps":[{"do":"pick","key":"element","from":"config","path":"elementDamageTypes","prompt":"Choose an Element"},{"do":"updateItem","item":"choice:strike","set":{"system.damageType":"{choice.element}"}}]},{"label":"Add 10ft to Range","when":["rule:pickedItem:strike:not:item:data:system.classification.style=melee"],"steps":[{"do":"updateItem","item":"choice:strike","add":{"system.range.value":10,"system.range.long":10}}]},{"label":"Add an Alternate Effect","when":[{"any":["rule:pickedItem:strike:not:item:data:system.accurateShiftUp>0","rule:pickedItem:strike:not:item:data:system.classification.style=melee&not:item:data:system.radius>0","rule:pickedItem:strike:not:item:data:system.hasArmorPiercing","rule:pickedItem:strike:not:item:data:system.damageType=maneuver","rule:pickedItem:strike:item:data:system.classification.style=melee&not:item:data:system.numTargets>1","rule:pickedItem:strike:not:item:data:system.classification.style=melee&not:item:data:system.numTargets>1"]}],"steps":[{"do":"choose","prompt":"Choose an Alternate Effect to add","options":[{"label":"Accurate (↑1)","when":["rule:pickedItem:strike:not:item:data:system.accurateShiftUp>0"],"steps":[{"do":"updateItem","item":"choice:strike","set":{"system.accurateShiftUp":1}}]},{"label":"Area of Effect (10ft x 10ft)","when":["rule:pickedItem:strike:not:item:data:system.classification.style=melee&not:item:data:system.radius>0"],"steps":[{"do":"updateItem","item":"choice:strike","set":{"system.radius":10,"system.shape":"burst"}}]},{"label":"Armor Piercing","when":["rule:pickedItem:strike:not:item:data:system.hasArmorPiercing"],"steps":[{"do":"updateItem","item":"choice:strike","set":{"system.hasArmorPiercing":true}}]},{"label":"Maneuver (↓1)","when":["rule:pickedItem:strike:not:item:data:system.damageType=maneuver"],"steps":[{"do":"updateItem","item":"choice:strike","set":{"system.damageType":"maneuver","system.shiftDown":1}}]},{"label":"Multiple Attacks (2, ↓1)","when":["rule:pickedItem:strike:item:data:system.classification.style=melee&not:item:data:system.numTargets>1"],"steps":[{"do":"updateItem","item":"choice:strike","set":{"system.numTargets":2,"system.shiftDown":1}}]},{"label":"Multiple Targets (2, ↓1)","when":["rule:pickedItem:strike:not:item:data:system.classification.style=melee&not:item:data:system.numTargets>1"],"steps":[{"do":"updateItem","item":"choice:strike","set":{"system.numTargets":2,"system.shiftDown":1}}]}]}]}]}]}
