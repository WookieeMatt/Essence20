      {"type":"Size","label":"Tactical Size Shift (smaller)","stacks":true,"steps":-1,"min":"long","when":["self:type:zord","rule:data:flags.essence20.pr1SizeShift.direction=smaller"]},
      {"type":"Trigger","event":"added","label":"Tactical Size Shift","when":["self:type:zord","not:rule:data:flags.essence20.pr1SizeShift"],"steps":[{"do":"choose","prompt":"Increase or decrease the Zord's Size Class?","auto":true,"options":[{"label":"E20.Pr1SizeShiftLarger","when":["not:rule:otherCopy:data:flags.essence20.pr1SizeShift.direction=smaller"],"steps":[{"do":"pick","key":"skill","from":"skill","essence":"strength","prompt":"Choose the Skill that goes up a step."},{"do":"keepValue","path":"system.skills.{choice.skill}.shift","at":"flags.essence20.pr1SizeShift.previous"},{"do":"updateActor","ladder":{"system.skills.{choice.skill}.shift":1},"ladderMax":"d12"},{"do":"addEffect","img":"icons/svg/aura.svg","changes":[{"key":"system.essences.strength.value","value":1},{"key":"system.health.bonus","value":2}]},{"do":"updateItem","set":{"flags.essence20.pr1SizeShift.direction":"larger","flags.essence20.pr1SizeShift.skill":"{choice.skill}"}},{"do":"chat","text":"{name}'s Tactical Size Shift: larger."}]},{"label":"E20.Pr1SizeShiftSmaller","when":["not:rule:otherCopy:data:flags.essence20.pr1SizeShift.direction=larger"],"steps":[{"do":"pick","key":"skill","from":"skill","essence":"speed","prompt":"Choose the Skill that goes up a step."},{"do":"keepValue","path":"system.skills.{choice.skill}.shift","at":"flags.essence20.pr1SizeShift.previous"},{"do":"updateActor","ladder":{"system.skills.{choice.skill}.shift":1},"ladderMax":"d12"},{"do":"addEffect","img":"icons/svg/aura.svg","changes":[{"key":"system.essences.speed.value","value":1},{"key":"system.movement.{movement}.bonus","value":10}]},{"do":"updateItem","set":{"flags.essence20.pr1SizeShift.direction":"smaller","flags.essence20.pr1SizeShift.skill":"{choice.skill}"}},{"do":"chat","text":"{name}'s Tactical Size Shift: smaller."}]}]}]},
