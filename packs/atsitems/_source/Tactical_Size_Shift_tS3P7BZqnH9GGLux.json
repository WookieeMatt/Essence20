      {"type":"Trigger","event":"removed","label":"Tactical Size Shift (Skill die back)","when":["rule:data:flags.essence20.pr1SizeShift.skill"],"steps":[{"do":"restoreValue","path":"system.skills.{item.flags.essence20.pr1SizeShift.skill}.shift","from":"flags.essence20.pr1SizeShift.previous"}]}
