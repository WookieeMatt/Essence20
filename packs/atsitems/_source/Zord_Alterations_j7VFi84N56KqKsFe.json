{
  "name": "Zord Alterations",
  "type": "perk",
  "img": "systems/essence20/assets/icons/items/perk.svg",
  "system": {
    "rules": [
      {"type":"Trigger","label":"Alter your Zord","event":"added","steps":[{"do":"warn","text":"E20.ZordAlterationNoZord","stop":true,"when":["not:self:ownsZord"]},{"do":"choose","options":[{"label":"+2 Strength","steps":[{"do":"updateActor","to":"ownZord","add":{"system.essences.strength.value":2}},{"do":"updateActor","to":"self","set":{"flags.essence20.zordAlteration":"strength"}}]},{"label":"+2 Speed","steps":[{"do":"updateActor","to":"ownZord","add":{"system.essences.speed.value":2}},{"do":"updateActor","to":"self","set":{"flags.essence20.zordAlteration":"speed"}}]},{"label":"+1 Strength and +1 Speed","steps":[{"do":"updateActor","to":"ownZord","add":{"system.essences.strength.value":1,"system.essences.speed.value":1}},{"do":"updateActor","to":"self","set":{"flags.essence20.zordAlteration":"both"}}]},{"label":"Size up, +1 Health","steps":[{"do":"shiftSize","to":"ownZord","steps":1,"ladder":"track"},{"do":"updateActor","to":"ownZord","add":{"system.health.max":1,"system.health.value":1}},{"do":"updateActor","to":"self","set":{"flags.essence20.zordAlteration":"sizeUp"}}]},{"label":"Size down (Huge at least), +10 ft Movement","steps":[{"do":"shiftSize","to":"ownZord","steps":-1,"ladder":"track","min":"huge"},{"do":"updateActor","to":"ownZord","add":{"system.movement.aerial.base":10,"system.movement.climb.base":10,"system.movement.ground.base":10,"system.movement.swim.base":10}},{"do":"updateActor","to":"self","set":{"flags.essence20.zordAlteration":"sizeDown"}}]},{"label":"Resistance to an Element","steps":[{"do":"pick","key":"element","from":"config","path":"elementDamageTypes"},{"do":"updateActor","to":"ownZord","set":{"system.resistances.{choice.element}":true}},{"do":"updateActor","to":"self","set":{"flags.essence20.zordAlteration":"resistance"}}]}]}]},
      {"type":"Trigger","event":"removed","label":"Zord Alterations removed (the alteration is undone)","steps":[{"do":"updateActor","to":"ownZord","add":{"system.essences.strength.value":-2},"when":["self:data:flags.essence20.zordAlteration=strength"]},{"do":"updateActor","to":"ownZord","add":{"system.essences.speed.value":-2},"when":["self:data:flags.essence20.zordAlteration=speed"]},{"do":"updateActor","to":"ownZord","add":{"system.essences.strength.value":-1,"system.essences.speed.value":-1},"when":["self:data:flags.essence20.zordAlteration=both"]},{"do":"shiftSize","to":"ownZord","steps":-1,"ladder":"track","when":["self:data:flags.essence20.zordAlteration=sizeUp"]},{"do":"updateActor","to":"ownZord","add":{"system.health.max":-1,"system.health.value":-1},"when":["self:data:flags.essence20.zordAlteration=sizeUp"]},{"do":"shiftSize","to":"ownZord","steps":1,"ladder":"track","when":["self:data:flags.essence20.zordAlteration=sizeDown"]},{"do":"updateActor","to":"ownZord","add":{"system.movement.aerial.base":-10,"system.movement.climb.base":-10,"system.movement.ground.base":-10,"system.movement.swim.base":-10},"when":["self:data:flags.essence20.zordAlteration=sizeDown"]},{"do":"updateActor","to":"ownZord","set":{"system.resistances.{choice.element}":false},"when":["self:data:flags.essence20.zordAlteration=resistance"]},{"do":"updateActor","to":"self","set":{"flags.essence20.zordAlteration":""}}]}
    ],
    "automation": {
