      {"type":"Use","label":"Fit a Drone Upgrade now due to the Riding Rig","steps":[{"do":"notify","text":"E20.RigNone","data":{"name":"{name}"},"level":"warn","stop":true,"when":["not:self:personalVehicle:ridingRig"]},{"do":"notify","text":"E20.GrantAlready","stop":true,"when":["calc:@item.flags.essence20.rigUpgrades - min(1, max(0, @level - 5)) - 2 * min(1, max(0, @level - 9)) - 3 * min(1, max(0, @level - 16)) >= 0"]},{"do":"choose","auto":true,"options":[{"label":"Standard","when":[{"any":["calc:@item.flags.essence20.rigUpgrades <= 1","calc:@item.flags.essence20.rigUpgrades = 3"]}],"steps":[{"do":"pickGrant","from":{"type":"upgrade","availabilities":["standard"],"tags":["item:data:system.type=drone"]},"to":"personalVehicle:ridingRig"},{"do":"updateItem","item":"self","add":{"flags.essence20.rigUpgrades":"1"}}]},{"label":"Limited","when":[{"any":["calc:@item.flags.essence20.rigUpgrades = 2","calc:@item.flags.essence20.rigUpgrades = 4"]}],"steps":[{"do":"pickGrant","from":{"type":"upgrade","availabilities":["limited"],"tags":["item:data:system.type=drone"]},"to":"personalVehicle:ridingRig"},{"do":"updateItem","item":"self","add":{"flags.essence20.rigUpgrades":"1"}}]},{"label":"Restricted","when":["calc:@item.flags.essence20.rigUpgrades = 5"],"steps":[{"do":"pickGrant","from":{"type":"upgrade","availabilities":["restricted"],"tags":["item:data:system.type=drone"]},"to":"personalVehicle:ridingRig"},{"do":"updateItem","item":"self","add":{"flags.essence20.rigUpgrades":"1"}}]}]}]}
