  "folder": "1pniIJKClYawi7Bc",
  "name": "Metallic Armor Power Up",
  "type": "power",
  "_id": "LotTM0zOcCBLkki4",
  "img": "systems/essence20/assets/icons/items/powers.svg",
  "system": {
    "rules": [
      {"type":"Use","label":"Switch Metallic Armor on, or end it","when":[{"any":["self:data:flags.essence20.metallicArmorActive","rule:data:system.canActivate"]}],"steps":[{"do":"choose","auto":true,"options":[{"label":"End Metallic Armor","when":["self:data:flags.essence20.metallicArmorActive"],"steps":[{"do":"updateActor","set":{"flags.essence20.metallicArmorActive":false},"add":{"system.health.bonus":-3},"min":0},{"do":"chat","text":"{name}'s Metallic Armor ends."}]},{"label":"Activate","when":["not:self:data:flags.essence20.metallicArmorActive"],"steps":[{"do":"activatePower"}]}]}]},
      {"type":"Trigger","event":"powerUsed","label":"Metallic Armor on: +3 temporary Health","when":["item:own","not:self:data:flags.essence20.metallicArmorActive"],"steps":[{"do":"updateActor","set":{"flags.essence20.metallicArmorActive":true},"add":{"system.health.bonus":3}},{"do":"chat","text":"Metallic Armor Power Up used on {name}."}]},
      {"type":"Trigger","event":"turnStart","label":"Metallic Armor upkeep (1 Personal Power)","when":["self:data:flags.essence20.metallicArmorActive"],"steps":[{"do":"choose","auto":true,"options":[{"label":"Pay","when":["self:data:system.powers.personal.value>=1"],"steps":[{"do":"updateActor","add":{"system.powers.personal.value":-1}}]},{"label":"Lapse","when":["self:data:system.powers.personal.value<1"],"steps":[{"do":"updateActor","set":{"flags.essence20.metallicArmorActive":false},"add":{"system.health.bonus":-3},"min":0}]}]}]},
      {"type":"MultipleTargets","label":"Metallic Armor: Multiple Targets (2)","when":["self:data:flags.essence20.metallicArmorActive"]},
      {"type":"HitRider","label":"Metallic Armor","scope":"incoming","note":-1,"when":["self:minion","holder:data:flags.essence20.metallicArmorActive"]},
      {"type":"Trigger","event":"targeted","label":"Metallic Armor ends: a Critical Success by a non-minion","outcome":"crit","when":["attack","self:data:flags.essence20.metallicArmorActive","not:target:minion"],"steps":[{"do":"updateActor","set":{"flags.essence20.metallicArmorActive":false},"add":{"system.health.bonus":-3},"min":0},{"do":"chat","text":"{name}'s Metallic Armor ends."}]},
      {"type":"Trigger","event":"takesDamage","label":"Metallic Armor ends: Defeated","when":["self:data:flags.essence20.metallicArmorActive","self:data:system.health.value<=0","not:damage:stun"],"steps":[{"do":"updateActor","set":{"flags.essence20.metallicArmorActive":false},"add":{"system.health.bonus":-3},"min":0},{"do":"chat","text":"{name}'s Metallic Armor ends."}]}
    ],
    "prerequisites": {"when":["self:level>=6","self:data:system.powers.personal.max>=4"]},
    "automation": {
      "status": "full",
      "notes": "<p>Use button (2 Personal Power, while Morphed): +3 temporary Health, 1 less damage from minions and Putties, and 1 Personal Power drained each turn to keep it up. It ends when you can't pay, take a critical hit from a non-minion, are Defeated or press Use again.</p><p>Automatic while active: all your attacks have Multiple Targets, and your token can't pick the Teleport (Blink) movement. Nothing limits how many targets an attack can have, so the extra target for attacks that already have Multiple Targets has nothing to add.</p>"
    },
