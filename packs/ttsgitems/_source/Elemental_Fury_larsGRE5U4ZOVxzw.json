      {"type":"Use","label":"Unleash the elemental Attack (once per scene)","limit":{"per":"scene"},"steps":[{"do":"pick","key":"element","from":"list","ifUnset":true,"prompt":"Choose this Zord's element.","options":[["air","Air"],["earth","Earth"],["fire","Fire"],["lightning","Lightning"],["water","Water"]]},{"do":"bestItem","type":"weaponEffect","by":"system.damageValue","where":["item:data:system.classification.style","item:data:system.classification.style!=melee","not:item:granted"],"message":"E20.Pr3FuryNoRanged","keep":{"furyClassification":"system.classification","furyRange":"system.range","furyBase":"system.damageValue","furyDefense":"system.defenseType"}},{"do":"setVar","key":"furyDamage","value":"2 * @var.furyBase"},{"do":"setVar","key":"furyDefense","value":"toughness","when":["not:var:furyDefense"]},{"do":"setVar","key":"furyType","value":"sonic","when":["rule:data:flags.essence20.rules.choices.element=air"]},{"do":"setVar","key":"furyLabel","value":"Air","when":["rule:data:flags.essence20.rules.choices.element=air"]},{"do":"setVar","key":"furyType","value":"blunt","when":["rule:data:flags.essence20.rules.choices.element=earth"]},{"do":"setVar","key":"furyLabel","value":"Earth","when":["rule:data:flags.essence20.rules.choices.element=earth"]},{"do":"setVar","key":"furyType","value":"fire","when":["rule:data:flags.essence20.rules.choices.element=fire"]},{"do":"setVar","key":"furyLabel","value":"Fire","when":["rule:data:flags.essence20.rules.choices.element=fire"]},{"do":"setVar","key":"furyType","value":"electric","when":["rule:data:flags.essence20.rules.choices.element=lightning"]},{"do":"setVar","key":"furyLabel","value":"Lightning","when":["rule:data:flags.essence20.rules.choices.element=lightning"]},{"do":"setVar","key":"furyType","value":"cold","when":["rule:data:flags.essence20.rules.choices.element=water"]},{"do":"setVar","key":"furyLabel","value":"Water","when":["rule:data:flags.essence20.rules.choices.element=water"]},{"do":"createItem","until":"scene","data":{"name":"{ruleItem.name} ({var.furyLabel})","type":"weapon","system":{}},"children":[{"name":"{ruleItem.name} ({var.furyLabel})","type":"weaponEffect","flags":{"essence20":{"furyElement":"{choice.element}"}},"system":{"classification":"{var.furyClassification}","damageType":"{var.furyType}","damageValue":"{var.furyDamage}","defenseType":"{var.furyDefense}","range":"{var.furyRange}"}}]},{"do":"chat","text":"{name} channels its Elemental Fury - roll it from the Zord's attacks (once per scene)."}]},
      {"type":"Trigger","event":"afterRoll","label":"Elemental Fury spent","when":["item:granted"],"steps":[{"do":"deleteItem","item":"granted","all":true}]},
